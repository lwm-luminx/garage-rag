"""Targets in the repository root"""

# tools/swiftcheck is a venv-only dev script (tree-sitter comes from the `dev` extras, which
# the @pypi hub does not expose), not a Bazel target.
# gazelle:exclude tools/swiftcheck

# tools/windows is run by .github/workflows/windows.yaml with the runner's Python, outside Bazel.
# gazelle:exclude tools/windows

# tools/llama regenerates //ext/nomic_embed:known_answers.json with the system Python, cmake and a
# compiler (.github/workflows/known-answers.yaml), outside Bazel.
# gazelle:exclude tools/llama

# tools/screenshots turns the store screenshot test's website captures into docs/ images, run by
# hand with the garage_python venv's Pillow, outside Bazel.
# gazelle:exclude tools/screenshots

exports_files(
    [
        "README.md",
    ],
    visibility = ["//:__subpackages__"],
)

# The gazelle binary + `gazelle` runner target live in //tools/gazelle (the
# default target for `aspect gazelle`). Run `aspect gazelle` to generate BUILDs.

platform(
    name = "macos",
    constraint_values = [
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)

# Platform aliases delegating to //bazel

# 1. Run adhoc on the local machine
alias(
    name = "local_adhoc",
    actual = "//bazel:local_adhoc",
    visibility = ["//visibility:public"],
)

alias(
    name = "adhoc",
    actual = "//bazel:adhoc",
    visibility = ["//visibility:public"],
)

alias(
    name = "local",
    actual = "//bazel:local",
    visibility = ["//visibility:public"],
)

# 2. Developer ID
alias(
    name = "developer_id",
    actual = "//bazel:developer_id",
    visibility = ["//visibility:public"],
)

# 3. Distribute via App Store
alias(
    name = "appstore",
    actual = "//bazel:appstore",
    visibility = ["//visibility:public"],
)

alias(
    name = "store",
    actual = "//bazel:store",
    visibility = ["//visibility:public"],
)

alias(
    name = "is_adhoc",
    actual = "//bazel:is_adhoc",
    visibility = ["//visibility:public"],
)

alias(
    name = "is_developer_id",
    actual = "//bazel:is_developer_id",
    visibility = ["//visibility:public"],
)

alias(
    name = "is_store",
    actual = "//bazel:is_store",
    visibility = ["//visibility:public"],
)

alias(
    name = "garage_rag",
    actual = "//garage_python/src/garage_rag",
)

alias(
    name = "macapp",
    actual = "//macapp",
)

alias(
    name = "installer",
    actual = "//macapp:installer",
    tags = ["manual"],
)

alias(
    name = "package",
    actual = "//macapp:package",
    tags = ["manual"],
)

alias(
    name = "install",
    actual = "//macapp:install",
    tags = ["manual"],
)

alias(
    name = "xcodeproj",
    actual = "//macapp:xcodeproj",
)

alias(
    name = "site",
    actual = "//docs:site",
)
