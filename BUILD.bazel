"""Targets in the repository root"""

# The Python scripts in the tree are development tools run outside Bazel, with the system
# Python or a throwaway venv: tools/swiftcheck (tree-sitter), tools/windows (windows.yaml),
# tools/llama (known-answers.yaml), tools/screenshots (the site's images), tools/third_party_notices.py
# and winapp/bazel's csproj check and repin. gazelle's Python plugin is off (//tools/gazelle), so
# their BUILD files, where one exists, are written by hand.

# winapp is the .NET solution for the Windows app. Its BUILD files mirror the csproj files by hand
# (//winapp/bazel:csproj_sync_test holds them together), so gazelle leaves the folder alone.
# gazelle:exclude winapp

# rust/ is a Cargo workspace; its BUILD files mirror each Cargo.toml by hand.
# gazelle:exclude rust

exports_files(
    [
        "LICENSE",
        "README.md",
        "ruff.toml",
    ],
    visibility = ["//visibility:public"],
)

# The gazelle binary + `gazelle` runner target live in //tools/gazelle (the
# default target for `aspect gazelle`). Run `aspect gazelle` to generate BUILDs.

platform(
    name = "macos",
    constraint_values = [
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)

# Platform aliases delegating to //bazel

# 1. Run adhoc on the local machine
alias(
    name = "local_adhoc",
    actual = "//bazel:local_adhoc",
    visibility = ["//visibility:public"],
)

alias(
    name = "adhoc",
    actual = "//bazel:adhoc",
    visibility = ["//visibility:public"],
)

alias(
    name = "local",
    actual = "//bazel:local",
    visibility = ["//visibility:public"],
)

alias(
    name = "is_adhoc",
    actual = "//bazel:is_adhoc",
    visibility = ["//visibility:public"],
)

alias(
    name = "is_developer_id",
    actual = "//bazel:is_developer_id",
    visibility = ["//visibility:public"],
)

alias(
    name = "is_store",
    actual = "//bazel:is_store",
    visibility = ["//visibility:public"],
)

alias(
    name = "macapp",
    actual = "//macapp",
)

alias(
    name = "xcodeproj",
    actual = "//macapp:xcodeproj",
)

alias(
    name = "site",
    actual = "//docs:site",
)
