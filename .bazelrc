# Curated flag presets generated by bazelrc-preset.bzl (run `tools/repin` to
# regenerate). Kept separate so it can be regenerated without touching this file.
import %workspace%/bazel/preset.bazelrc

# See https://aspect.build/blog/configuring-bazels-downloader
common --downloader_config=bazel/downloader.cfg



# Select the uv hub's dependency group (matches project name in pyproject.toml).
common --@pypi//dep_group=garage_rag
# Select the hermetic free-threaded 3.14 (3.14t) interpreter from @python_interpreters.
# Its toolchains are gated on these flags (target_settings = python_version_is_3_14 and
# freethreaded_is_true); without them, resolution falls through to a transitively-registered
# rules_python interpreter. The freethreaded flag also makes the uv hub pick cp314t wheels.
common --@aspect_rules_py//py/private/interpreter:python_version=3.14
common --@aspect_rules_py//py/private/interpreter:freethreaded=true
common --@rules_python//python/config_settings:py_freethreaded=yes

# winapp/: a C# target sees its dependencies' dependencies, as NuGet and MSBuild let a project use
# every package and project it reaches transitively; the BUILD files mirror the csproj files'
# direct references only.
common --@rules_dotnet//dotnet/settings:strict_deps=false




# Python tests that need a real Postgres (garage_python/tests/test_postgres.py) run
# against the server this names and skip when it is unset; see "Testing against
# Postgres" in CLAUDE.md.
test --test_env=GARAGE_TEST_DATABASE_URL

# garage_python/tests/test_inference_live.py runs against a real LM Studio / Ollama
# when these name a model (and skips otherwise); see that file's docstring.
test --test_env=GARAGE_TEST_OLLAMA_EMBED_MODEL
test --test_env=GARAGE_TEST_OLLAMA_URL
test --test_env=GARAGE_TEST_LMSTUDIO_EMBED_MODEL
test --test_env=GARAGE_TEST_LMSTUDIO_CHAT_MODEL
test --test_env=GARAGE_TEST_LMSTUDIO_URL
test --test_env=GARAGE_TEST_LMSTUDIO_AUTH_ON
test --test_env=GARAGE_LMSTUDIO_API_TOKEN

# Load settings & overrides specific to the current user from `user.bazelrc`.
# That file is git-ignored so settings aren't shared with team members. This is
# the last statement in this config so user settings can override flags set
# above. See https://bazel.build/configure/best-practices#bazelrc-file.
try-import %workspace%/user.bazelrc

# Automatically look up your local codesigning identity from your macOS Keychain
build --apple_generate_dsym
build --apple_platform_type=macos
# One CPU list for every config. Bazel names a transitioned configuration's output
# directory (`bazel-out/...-ST-<hash>`) by its difference from the command-line baseline,
# and rules_apple (and //bazel:macos_application.bzl's transitions) set --macos_cpus under
# the app. Had only the signed configs set arm64, the ad-hoc and signed builds would land
# //ext in different directories and rebuild it on every switch. Signing is a separate
# codesign step over those outputs, so the configs share everything below it.
build --macos_cpus=arm64
build --workspace_status_command=bazel/workspace_status.sh

build --platforms=//bazel:local_signed
# Platform configuration presets
build:adhoc --platforms=//bazel:adhoc
build:local --platforms=//bazel:local
# Like adhoc, but signed with the self-signed certificate from
# `bazel run //tools/signing:local_identity`. Ad-hoc signatures pin the cdhash,
# so every rebuild is a new identity and the app's Keychain items (the Postgres
# password, the LM Studio token) prompt again; a certificate pins its own hash
# instead, which a rebuild does not change. Put `build --config=local_signed` in
# user.bazelrc to make it the local default.
build:local_signed --platforms=//bazel:local_signed
# CI runners have no local signing identity (and no Keychain to put one in), so
# `aspect` runs there with --config=ci and sign ad hoc instead.
build:ci --platforms=//bazel:adhoc
build:developer_id --platforms=//bazel:developer_id
build:appstore --platforms=//bazel:store
# The App Store build to upload: optimized, which (unlike signing) changes every compile
# action, so it shares nothing with the fastbuild configs above.
build:appstore_release --config=appstore --compilation_mode=opt
build:store --platforms=//bazel:store

# On a Linux host (the devcontainer, CI's Linux jobs) build for that host: the macOS platforms above
# have no matching execution platform there, so no test could run. The macOS-only targets are not
# buildable on Linux either way; winapp/ and the Python targets are. --enable_platform_specific_config
# applies `build:linux` only when Bazel runs on Linux. It is repeated here as a `build` option, after
# the --platforms above: the presets' `common` copy expands before every `build` line, so the
# local_signed default would win again.
build --enable_platform_specific_config
build:linux --platforms=@platforms//host

# Build against the bundled PostgreSQL 19 beta instead of 18 (see //ext:postgres_version).
common:pg19 --//ext:postgres_version=19
