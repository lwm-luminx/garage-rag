+# The Roslyn the toolchain's compiler is (SDK 10.0.400 ships Microsoft.CodeAnalysis 5.9). NuGet
+# uses the analyzers/dotnet/roslyn<X.Y> folder with the highest version not above it.
+_ROSLYN_VERSION = (5, 9)
+
+def _roslyn_version(folder):
+    major, _, minor = folder.removeprefix("roslyn").partition(".")
+    return (int(major), int(minor or "0"))
+
+def _resolve_roslyn_analyzers(groups):
+    """Adds every analyzer in each language's best roslyn<X.Y> folder, as MSBuild/NuGet pick it."""
+    group = groups["analyzers"]
+    for key in [k for k in group.keys() if k.startswith("versioned/")]:
+        usable = [v for v in group[key].keys() if _roslyn_version(v) <= _ROSLYN_VERSION]
+        if usable:
+            best = sorted(usable, key = _roslyn_version)[-1]
+            group[key.removeprefix("versioned/")].extend(group[key][best])
+
