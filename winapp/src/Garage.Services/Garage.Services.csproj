<Project Sdk="Microsoft.NET.Sdk">

  <!-- Garage's service processes (docs/plans/windows.md §2.1): one executable, started once per
       service by the app's ServiceManager (service core, service ingest, service mcp), each in its
       own process as each XPC service is on the Mac. Each runs its Rust library (garage_service_ffi,
       garage_ingest_ffi, garage_mcp_ffi) in-process through P/Invoke and answers the app over gRPC
       on a named pipe only the signed-in user can open. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Garage.Services</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated gRPC code carries no XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Garage.Grpc\Garage.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Garage.Services.Tests" />
  </ItemGroup>

</Project>
