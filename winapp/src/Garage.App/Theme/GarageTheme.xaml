        <ResourceDictionary x:Key="HighContrast">
            <!-- The tokens, as Garage{Name}Brush -->
            <SolidColorBrush x:Key="GarageViolet050Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GarageViolet100Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GarageViolet300Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GarageViolet400Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GarageViolet500Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GarageViolet700Brush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="GarageViolet900Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
