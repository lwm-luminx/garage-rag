            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF8C5" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FFEBE9" />
            <!-- The glyph on a tinted status circle: on-brand, the highlight's text colour in high contrast -->
            <SolidColorBrush x:Key="TintGlyphBrush" Color="#FFFFFF" />
