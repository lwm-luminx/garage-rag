<?xml version="1.0" encoding="utf-8"?>
<!-- Garage's look: the design system's colours, and WinUI's own resource keys pointed at them, so every
     control and page takes them without a style of its own. Merged in App.xaml.
     The colours are the Garage design system's tokens, light and dark; high contrast keeps the
     person's own system colours. -->
