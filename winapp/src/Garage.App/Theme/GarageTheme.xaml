            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#1A7F37" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#9A6700" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C4232D" />
