            <!-- The tokens, as Garage{Name}Brush -->
            <SolidColorBrush x:Key="GarageViolet050Brush" Color="#F6F4FF" />
            <SolidColorBrush x:Key="GarageViolet100Brush" Color="#ECE7FF" />
            <SolidColorBrush x:Key="GarageViolet300Brush" Color="#B9A9F7" />
