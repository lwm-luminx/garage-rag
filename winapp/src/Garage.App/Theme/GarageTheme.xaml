            <SolidColorBrush x:Key="GarageViolet500Brush" Color="#7056DC" />
            <SolidColorBrush x:Key="GarageViolet700Brush" Color="#4F38B8" />
            <SolidColorBrush x:Key="GarageViolet900Brush" Color="#2A1D6B" />
            <SolidColorBrush x:Key="GarageSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GarageSurfaceRaisedBrush" Color="#F7F6FB" />
            <SolidColorBrush x:Key="GarageSurfaceSunkenBrush" Color="#EEECF5" />
            <SolidColorBrush x:Key="GarageInkBrush" Color="#1D1A2E" />
