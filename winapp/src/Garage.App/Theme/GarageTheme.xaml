            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#D29922" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF7B72" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#0F2D1A" />
