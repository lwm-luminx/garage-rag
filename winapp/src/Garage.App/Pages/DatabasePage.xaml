<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Garage.App.Pages.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:db="using:Garage.App.Core.Database">

    <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left" Padding="0,0,16,16">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock x:Uid="DatabasePage_1" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <Button x:Uid="DatabasePage_2" Click="OnRefresh" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </StackPanel>

        <!-- Garage's own Postgres: the Mac's DatabaseHeadline row, and Reset Database. -->
        <Border x:Name="ServerCard" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ServerCircle" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top">
                    <FontIcon x:Name="ServerGlyph" FontSize="18" Foreground="{ThemeResource TintGlyphBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="ServerTitle" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="database.server" />
                    <TextBlock x:Name="ServerDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ServerWhere" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <Button x:Uid="DatabasePage_ResetButton" x:Name="ResetButton" Grid.Column="2" VerticalAlignment="Top" Click="OnReset" AutomationProperties.AutomationId="database.reset">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock x:Uid="DatabasePage_3" /></StackPanel>
                </Button>
            </Grid>
        </Border>
        <InfoBar x:Name="ResetBar" IsClosable="True" AutomationProperties.AutomationId="database.resetOutcome" />

        <!-- Schema and Backups: only with Garage's own Postgres. -->
        <StackPanel x:Name="OwnServerBoxes" Spacing="12">
            <TextBlock x:Uid="DatabasePage_4" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="SchemaGlyph" FontSize="18" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="SchemaTitle" FontWeight="SemiBold" AutomationProperties.AutomationId="database.schema" />
                        <TextBlock x:Name="SchemaDetail" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="Extensions" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   AutomationProperties.AutomationId="database.extensions" />
                    </StackPanel>
                    <Button x:Name="SchemaButton" Grid.Column="2" VerticalAlignment="Top" Click="OnApplySchema" AutomationProperties.AutomationId="database.schema.apply" />
                </Grid>
            </Border>

            <TextBlock x:Uid="DatabasePage_5" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DatabasePage_6" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Uid="DatabasePage_BackupButton" x:Name="BackupButton" Click="OnBackup" AutomationProperties.AutomationId="database.backup" />
                        <Button x:Uid="DatabasePage_RestoreButton" x:Name="RestoreButton" Click="OnRestore" AutomationProperties.AutomationId="database.restore" />
                    </StackPanel>
                </Grid>
            </Border>
            <InfoBar x:Name="ActionBar" IsClosable="True" AutomationProperties.AutomationId="database.actionResult" />
        </StackPanel>
        <InfoBar x:Uid="DatabasePage_ServerBar" x:Name="ServerBar" IsOpen="True" IsClosable="False" Severity="Informational"
                 Message="Garage uses the database your garage.json names. With Garage's own Postgres (GARAGE_POSTGRES_HOME, or postgres\ beside the app), this page shows its server and offers Reset Database." />

        <TextBlock x:Uid="DatabasePage_7" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
        <InfoBar x:Uid="DatabasePage_ErrorBar" x:Name="ErrorBar" Severity="Error" IsClosable="False" />
        <ItemsControl x:Name="Figures" AutomationProperties.AutomationId="database.contents">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="db:DatabaseFigure">
                    <Border Padding="16,12" MinWidth="130" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Value}" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Uid="DatabasePage_EmptyNote" x:Name="EmptyNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
    </ScrollViewer>
</Page>
