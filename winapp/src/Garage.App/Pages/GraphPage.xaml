<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Garage.App.Pages.GraphPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:graph="using:Garage.App.Core.Graph">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="GraphPage_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="GraphPage_SearchBox" x:Name="SearchBox" KeyDown="OnSearchKeyDown" AutomationProperties.AutomationId="graph.search" />
            <ComboBox x:Uid="GraphPage_KindBox" x:Name="KindBox" Grid.Column="1" MinWidth="150" SelectionChanged="OnKindChanged"
                      AutomationProperties.AutomationId="graph.kind" />
            <NumberBox x:Uid="GraphPage_DepthBox" x:Name="DepthBox" Grid.Column="2" Minimum="1" Maximum="4" SpinButtonPlacementMode="Inline"
                       ValueChanged="OnDepthChanged" AutomationProperties.AutomationId="graph.depth" />
            <Button x:Uid="GraphPage_RefreshButton" x:Name="RefreshButton" Grid.Column="3" Click="OnRefresh" VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="graph.refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" x:Name="FilterBar" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Spacing="6" Padding="0,0,0,6" />
        </ScrollViewer>

        <!-- The whole page's empty state or failure, in place of the browser. -->
        <StackPanel Grid.Row="3" x:Name="PageMessage" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
            <FontIcon x:Name="PageMessageGlyph" Glyph="&#xE968;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PageMessageTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="graph.empty.title" />
            <TextBlock x:Name="PageMessageText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Uid="GraphPage_RetryButton" x:Name="RetryButton" HorizontalAlignment="Center" Click="OnRefresh" />
            <ProgressRing x:Name="PageProgress" IsActive="False" />
        </StackPanel>

        <Grid Grid.Row="3" x:Name="Browser" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="200" />
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="1.4*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Results (left). -->
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="ResultsList" SelectionMode="Single" SelectionChanged="OnResultSelected" AutomationProperties.AutomationId="graph.results">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="graph:GraphVertexItem">
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind LabelName}" /> <Run Text="{x:Bind KeyText}" FontFamily="Consolas" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="ResultsEmpty" Spacing="6" VerticalAlignment="Center" Padding="12">
                    <ProgressRing x:Name="SearchProgress" IsActive="False" />
                    <TextBlock x:Name="ResultsEmptyText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="ResultsCount" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="graph.results.count" />
            </Grid>

            <!-- Picture (middle). -->
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="PictureFrame" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Canvas x:Name="Picture" Background="Transparent" SizeChanged="OnPictureSizeChanged"
                                PointerMoved="OnPicturePointerMoved" PointerExited="OnPicturePointerExited"
                                Tapped="OnPictureTapped" DoubleTapped="OnPictureDoubleTapped"
                                AutomationProperties.AutomationId="graph.canvas" />
                        <StackPanel x:Name="PictureEmpty" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Padding="12">
                            <TextBlock x:Name="PictureEmptyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PictureEmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ProgressRing x:Name="PictureProgress" IsActive="False" Width="24" Height="24" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="graph.summary" />
                    <TextBlock x:Uid="GraphPage_Hint" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Grid>

            <!-- Inspector (right). -->
            <ScrollViewer Grid.Column="2" x:Name="Inspector">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="DetailBadge" CornerRadius="4" Padding="6,1">
                            <TextBlock x:Name="DetailLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="DetailKey" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="Consolas" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Uid="GraphPage_CenterBadge" x:Name="CenterBadge" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="graph.detail.title" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Uid="GraphPage_CopyButton" Click="OnCopyTitle" />
                        <Button x:Uid="GraphPage_CenterButton" x:Name="CenterButton" Click="OnCenterHere" AutomationProperties.AutomationId="graph.detail.center" />
                        <Button x:Name="OpenDocumentButton" Click="OnOpenDocument" AutomationProperties.AutomationId="graph.detail.openDocument" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectionsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="ConnectionsPanel" Spacing="8" />
                    <TextBlock x:Uid="GraphPage_PropertiesHeader" x:Name="PropertiesHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl x:Name="PropertiesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="graph:GraphProperty">
                                <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxLines="4" TextTrimming="CharacterEllipsis" Margin="0,1">
                                    <Run Text="{x:Bind Key}" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /> <Run Text="{x:Bind Value}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Column="2" x:Uid="GraphPage_InspectorEmpty" x:Name="InspectorEmpty" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
