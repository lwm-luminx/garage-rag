<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Garage.App.Pages.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Garage.App"
    xmlns:src="using:Garage.App.Core.Sources">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock x:Uid="SourcesPage_1" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="sources.summary" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Uid="SourcesPage_AddButton" x:Name="AddButton" Style="{StaticResource AccentButtonStyle}" Click="OnAdd" AutomationProperties.AutomationId="sources.add">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock x:Uid="SourcesPage_2" /></StackPanel>
            </Button>
            <Button x:Uid="SourcesPage_UpdateEverythingButton" x:Name="UpdateEverythingButton" Click="OnUpdateEverything" AutomationProperties.AutomationId="sources.updateEverything">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE895;" FontSize="14" /><TextBlock x:Uid="SourcesPage_3" /></StackPanel>
            </Button>
            <Button x:Uid="SourcesPage_ScanAllButton" x:Name="ScanAllButton" Click="OnScanAll" AutomationProperties.AutomationId="sources.scanAll" />
            <Button x:Uid="SourcesPage_SyncButton" x:Name="SyncButton" Click="OnSync" AutomationProperties.AutomationId="sources.sync" />
            <Button x:Uid="SourcesPage_StopButton" x:Name="StopButton" Click="OnStop" AutomationProperties.AutomationId="sources.stop">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE71A;" FontSize="14" /><TextBlock x:Uid="SourcesPage_StopText" x:Name="StopText" /></StackPanel>
            </Button>
        </StackPanel>

        <!-- What the pipeline is doing: the Status page's Library headline while a run goes. -->
        <Border x:Name="ActivityCard" Grid.Row="2" Padding="14,10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ActivityGlyph" FontSize="14" />
                    <TextBlock x:Name="ActivityTitle" FontWeight="SemiBold" AutomationProperties.AutomationId="sources.activity" />
                    <TextBlock x:Name="ActivityPercent" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressBar x:Name="ActivityBar" Maximum="1" />
                <TextBlock x:Name="ActivityDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <InfoBar x:Name="ResultBar" Grid.Row="3" IsClosable="True" AutomationProperties.AutomationId="sources.result" />

        <ListView x:Name="RowsList" Grid.Row="4" SelectionMode="None" AutomationProperties.AutomationId="sources.list">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="src:SourceRowPresentation">
                    <Grid ColumnSpacing="14" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Background="{x:Bind local:Look.TintBrush(Tint)}">
                            <FontIcon Glyph="{x:Bind local:Look.SourceGlyph(Symbol)}" FontSize="16" Foreground="{ThemeResource TintGlyphBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{x:Bind Badges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="src:SourceBadge">
                                            <Border Padding="6,1" CornerRadius="4" BorderThickness="1" BorderBrush="{x:Bind local:Look.ToneBrush(Tone)}">
                                                <TextBlock Text="{x:Bind Text}" FontSize="10" Foreground="{x:Bind local:Look.ToneBrush(Tone)}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Path}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{x:Bind local:Look.Percent(Progress)}" IsIndeterminate="{x:Bind IsIndeterminate}" Margin="0,4,0,0" />
                            <Grid>
                                <TextBlock Text="{x:Bind Status}" Foreground="{x:Bind local:Look.ToneBrush(StatusTone)}" />
                                <TextBlock Text="{x:Bind Counts}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind CurrentItem}" Visibility="{x:Bind local:Look.VisibleIf(CurrentItem)}" FontFamily="Consolas" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Error}" Visibility="{x:Bind local:Look.VisibleIf(Error)}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button x:Uid="SourcesPage_4" Tag="{x:Bind Title}" Click="OnScanAndIngest" Visibility="{x:Bind local:Look.HiddenWhen(ShowsCancel)}">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                            </Button>
                            <Button x:Uid="SourcesPage_5" Tag="{x:Bind Title}" Click="OnCancelOne" Visibility="{x:Bind local:Look.VisibleWhen(ShowsCancel)}"
                                    IsEnabled="{x:Bind local:Look.Not(CancelDisabled)}" Content="{x:Bind CancelTitle}" />
                            <Button x:Uid="SourcesPage_MoreButton" Tag="{x:Bind Title}" AutomationProperties.AutomationId="sources.row.more">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnMoreOpening">
                                        <MenuFlyoutItem x:Uid="SourcesPage_ScanOnlyItem" AutomationProperties.AutomationId="sources.menu.scanOnly" Tag="{x:Bind Title}" Click="OnScanOne">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="SourcesPage_IncludeCodeItem" AutomationProperties.AutomationId="sources.menu.includeCode" Tag="{x:Bind Title}" Click="OnIngestIncludingCode">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="SourcesPage_ReindexItem" AutomationProperties.AutomationId="sources.menu.reindex" Tag="{x:Bind Title}" Click="OnReindex">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="SourcesPage_GleanItem" AutomationProperties.AutomationId="sources.menu.glean" Tag="{x:Bind Title}" Click="OnGleanSource">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA80;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Uid="SourcesPage_CheckDeletedItem" AutomationProperties.AutomationId="sources.menu.checkDeleted" Tag="{x:Bind Title}" Click="OnCheckDeleted">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9CE;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="SourcesPage_ForgetDeletedItem" AutomationProperties.AutomationId="sources.menu.forgetDeleted" Tag="{x:Bind Title}" Click="OnForgetDeleted">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Uid="SourcesPage_ShowInExplorerItem" AutomationProperties.AutomationId="sources.menu.showInExplorer" Tag="{x:Bind Title}" Click="OnShowInExplorer">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="SourcesPage_EditItem" AutomationProperties.AutomationId="sources.menu.edit" Tag="{x:Bind Title}" Click="OnEdit">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Uid="SourcesPage_RemoveItem" AutomationProperties.AutomationId="sources.menu.remove" Tag="{x:Bind Title}" Click="OnRemove">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
