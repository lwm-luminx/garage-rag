<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Garage.App.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left" Padding="0,0,16,16">
            <Border Style="{StaticResource PageTitleRuleStyle}">
                <TextBlock x:Uid="ServicesPage_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            </Border>

            <!-- One row per service process, with Test, Restart and its self tests (the Mac's ServicesView). -->
            <StackPanel x:Name="ServicesSection" Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="ServicesPage_Intro" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="StatusPage_status_services_testAll" Click="OnTestAll" AutomationProperties.AutomationId="status.services.testAll" />
                        <Button x:Uid="StatusPage_RestartAllButton" x:Name="RestartAllButton" Click="OnRestartAll" AutomationProperties.AutomationId="status.services.restartAll" />
                        <Button x:Uid="StatusPage_status_services_refresh" Click="OnRefreshServices" AutomationProperties.AutomationId="status.services.refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource GarageCardStyle}" Padding="16,8">
                    <StackPanel x:Name="ServiceRows" AutomationProperties.AutomationId="status.services" />
                </Border>
            </StackPanel>
            <TextBlock x:Uid="StatusPage_DevBackendNote" x:Name="DevBackendNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
