<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Garage.App.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left" Padding="0,0,16,16">
            <Border Style="{StaticResource PageTitleRuleStyle}">
                <TextBlock x:Uid="StatusPage_1" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            </Border>

            <InfoBar x:Name="Connection" IsOpen="True" IsClosable="False" AutomationProperties.AutomationId="status.connection">
                <InfoBar.ActionButton>
                    <Button x:Uid="StatusPage_RefreshButton" x:Name="RefreshButton" Click="OnRefresh" AutomationProperties.AutomationId="status.refresh" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The services the Services page draws in red or orange; hidden while all are well (the Mac's Health). -->
            <InfoBar x:Name="ServiceIssuesBar" IsOpen="False" IsClosable="False" AutomationProperties.AutomationId="status.serviceIssues">
                <InfoBar.ActionButton>
                    <Button x:Uid="StatusPage_ShowServicesButton" Click="OnShowServices" AutomationProperties.AutomationId="status.showServices" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Library: what the pipeline is doing, or what is left to index (the Mac's IndexingPresentation). -->
            <TextBlock x:Uid="StatusPage_2" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Border Style="{StaticResource GarageCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LibraryCircle" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top">
                        <FontIcon x:Name="LibraryGlyph" FontSize="18" Foreground="{ThemeResource TintGlyphBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="LibraryTitle" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="status.library.title" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="LibraryPercent" VerticalAlignment="Bottom" Margin="0,0,0,3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ProgressBar x:Name="LibraryBar" Maximum="1" />
                        <TextBlock x:Name="LibraryDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   AutomationProperties.AutomationId="status.library.detail" />
                        <TextBlock x:Name="LibraryItem" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="LibraryTrail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="status.library.stage" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Uid="StatusPage_UpdateEverythingButton" x:Name="UpdateEverythingButton" Click="OnUpdateEverything" AutomationProperties.AutomationId="status.updateEverything"
 >
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="14" /><TextBlock x:Uid="StatusPage_3" /></StackPanel>
                        </Button>
                        <Button x:Uid="StatusPage_StopButton" x:Name="StopButton" Click="OnStop" AutomationProperties.AutomationId="status.stop">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="14" /><TextBlock x:Uid="StatusPage_StopText" x:Name="StopText" /></StackPanel>
                        </Button>
                        <Button x:Uid="StatusPage_AddSourceButton" x:Name="AddSourceButton" Style="{StaticResource AccentButtonStyle}" Click="OnAddSource"
                                AutomationProperties.AutomationId="status.addSource" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Automatic Updates: under Library, since a scheduled run is the same scan, read and index. -->
            <TextBlock x:Uid="StatusPage_4" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Border Style="{StaticResource GarageCardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ToggleSwitch x:Uid="StatusPage_AutomaticSwitch" x:Name="AutomaticSwitch" Toggled="OnAutomaticToggled"
                                      AutomationProperties.AutomationId="status.maintenance.enabled" />
                        <ComboBox x:Uid="StatusPage_IntervalBox" x:Name="IntervalBox" MinWidth="140" SelectionChanged="OnIntervalChanged"
                                  AutomationProperties.AutomationId="status.maintenance.interval" />
                    </StackPanel>
                    <CheckBox x:Uid="StatusPage_AtLaunchBox" x:Name="AtLaunchBox" Click="OnAtLaunchClicked"
                              AutomationProperties.AutomationId="status.maintenance.atLaunch" />
                    <TextBlock x:Uid="StatusPage_5" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
