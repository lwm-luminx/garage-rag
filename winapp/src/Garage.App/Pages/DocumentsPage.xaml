<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Garage.App.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Garage.App.Core.Documents">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PageTitleRuleStyle}">
            <TextBlock x:Uid="DocumentsPage_1" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="DocumentsPage_FilterBox" x:Name="FilterBox" KeyDown="OnFilterKeyDown"
                     AutomationProperties.AutomationId="documents.filter" />
            <ComboBox x:Uid="DocumentsPage_SourceBox" x:Name="SourceBox" Grid.Column="1" SelectionChanged="OnFilterChanged" MinWidth="140" />
            <ComboBox x:Uid="DocumentsPage_ClassBox" x:Name="ClassBox" Grid.Column="2" SelectionChanged="OnFilterChanged" MinWidth="140" />
            <ComboBox x:Uid="DocumentsPage_TrustBox" x:Name="TrustBox" Grid.Column="3" SelectionChanged="OnFilterChanged" MinWidth="140" />
            <Button x:Uid="DocumentsPage_2" Grid.Column="4" Click="OnRefresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="DocumentsList" SelectionMode="Single" SelectionChanged="OnDocumentSelected"
                      AutomationProperties.AutomationId="documents.list">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="docs:DocumentListItem">
                        <StackPanel Padding="0,6" Spacing="4">
                            <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind SourceSlug}" /> · <Run Text="{x:Bind CorpusClass}" /> · <Run Text="{x:Bind Counts}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyPanel" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="CountText" AutomationProperties.AutomationId="documents.count" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />

            <ScrollViewer Grid.Column="1" Grid.RowSpan="2">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <TextBlock x:Uid="DocumentsPage_Placeholder" x:Name="Placeholder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressRing x:Name="DetailProgress" IsActive="False" HorizontalAlignment="Left" />
                    <!-- Outside DetailPanel: a failed load has no detail, and must still say why. -->
                    <InfoBar x:Name="DetailErrorBar" Severity="Error" IsClosable="False" AutomationProperties.AutomationId="documents.detailError" />
                    <StackPanel x:Name="DetailPanel" Spacing="12">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="DetailSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailUri" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="DetailExtracted" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DetailAuthors" TextWrapping="Wrap" />
                        <TextBlock x:Name="FactsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl x:Name="FactsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ChunksHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl x:Name="ChunksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="docs:DocumentChunk">
                                    <StackPanel Spacing="4" Margin="0,0,0,12">
                                        <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
