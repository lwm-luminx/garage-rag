load("//winapp/bazel:defs.bzl", "garage_csharp_library")
load("//winapp/bazel:proto.bzl", "csharp_proto_srcs")

# Mirrors Garage.Plugins.csproj.

# <Protobuf Include="..\..\..\proto\garage_plugin.proto" GrpcServices="Client" />
csharp_proto_srcs(
    name = "garage_plugin_proto_cs",
    src = "//proto:garage_plugin.proto",
    grpc_services = "Client",
)

garage_csharp_library(
    name = "Garage.Plugins",
    srcs = glob(
        ["**/*.cs"],
        exclude = [
            "bin/**",
            "obj/**",
        ],
    ) + [":garage_plugin_proto_cs"],
    allow_unsafe_blocks = True,
    internals_visible_to = ["Garage.Plugins.Tests"],
    # Generated protobuf code carries no XML docs.
    nowarn = ["CS1591"],
    visibility = ["//winapp:__subpackages__"],
    deps = [
        "@winapp_nuget//google.protobuf",
        "@winapp_nuget//grpc.net.client",
    ],
)
