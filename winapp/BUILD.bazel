# The Windows app's .NET projects. Garage.Python, Garage.Grpc, Garage.App.Core, Garage.Services and
# their tests build under Bazel (//winapp/bazel:defs.bzl); Garage.App (WinUI 3) and
# Garage.App.UITests (FlaUI) build only with the .NET SDK on Windows. See README.md, "Bazel".

exports_files(["winapp.MODULE.bazel"])

# What //winapp/bazel:csproj_sync_test reads besides each project's own csproj and BUILD.bazel.
filegroup(
    name = "solution_files",
    srcs = [
        "Directory.Build.props",
        "Directory.Packages.props",
        "Garage.slnx",
        "nuget.bzl",
    ],
    visibility = ["//winapp/bazel:__pkg__"],
)
