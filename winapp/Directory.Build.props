<Project>
  <!-- Settings every project in winapp/ shares (`dotnet build winapp/Garage.slnx`). The Bazel build
       compiles with the same settings (bazel/defs.bzl); //winapp/bazel:csproj_sync_test fails if
       they part. See winapp/README.md, "Bazel". -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <Company>Garage</Company>
    <Product>Garage</Product>
  </PropertyGroup>
</Project>
