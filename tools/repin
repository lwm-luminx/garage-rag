#!/usr/bin/env bash

# After changing a Bazel module dependency, run this script to regenerate the
# lockfiles. Also run once after `aspect init` to materialize the placeholder
# lockfiles the template ships with.
set -o errexit -o nounset -o pipefail

cd "$(dirname "$0")/.."

# Regenerate the curated bazelrc preset (bazelrc-preset.bzl). Keeps
# bazel/preset.bazelrc in sync so //bazel:preset.update_test passes.
bazel run //bazel:preset.update

# Accept any resulting MODULE.bazel.lock changes.
bazel mod deps --lockfile_mode=update

# The app redistributes every crate it links; refresh their license texts after a Cargo.lock
# change. //data/notices:third_party_notices_test fails until this is committed.
python3 tools/third_party_notices.py
