diff --git a/meson.build b/meson.build
index d05634f..120372d 100644
--- a/meson.build
+++ b/meson.build
@@ -3293,6 +3293,14 @@ if sema_kind == 'unnamed_posix' and \
   sema_kind = 'sysv'
 endif
 
+# An App Sandbox build cannot use System V IPC at all: process-shared
+# pthread semaphores in the mmap'd segment, and a file lock as the
+# data directory interlock (see sysv_shmem.c).
+if get_option('appstore')
+  sema_kind = 'pthread'
+  cdata.set('APPSTORE', 1)
+endif
+
 cdata.set('USE_@0@_SHARED_MEMORY'.format(shmem_kind.to_upper()), 1)
 cdata.set('USE_@0@_SEMAPHORES'.format(sema_kind.to_upper()), 1)
 
