 src/backend/port/pthread_sema.c  | 269 +++++++++++++++++++++++++++++++
 src/include/pg_config.h.in       |   6 +
 src/tools/pgindent/typedefs.list |   1 +
 9 files changed, 370 insertions(+), 2 deletions(-)
 create mode 100644 src/backend/port/pthread_sema.c

diff --git a/configure b/configure
index 6b05d4c..9062296 100755
--- a/configure
+++ b/configure
@@ -860,6 +860,7 @@ with_wal_blocksize
 with_llvm
 enable_depend
 enable_cassert
+enable_appstore
 with_icu
 with_tcl
 with_tclconfig
@@ -1557,6 +1558,7 @@ Optional Features:
                           enable injection points (for testing)
   --enable-depend         turn on automatic dependency tracking
   --enable-cassert        enable assertion checks (for debugging)
+  --enable-appstore       build without System V IPC, for the macOS App Sandbox
   --disable-largefile     omit support for large files
 
 Optional Packages:
@@ -8073,6 +8075,29 @@ else
 fi
 
 
+# Check whether --enable-appstore was given.
+if test "${enable_appstore+set}" = set; then :
+  enableval=$enable_appstore;
+  case $enableval in
+    yes)
+
+$as_echo "#define APPSTORE 1" >>confdefs.h
+
+      ;;
+    no)
+      :
+      ;;
+    *)
+      as_fn_error $? "no argument expected for --enable-appstore option" "$LINENO" 5
+      ;;
+  esac
+
+else
+  enable_appstore=no
+
+fi
+
+
 
 
 #
@@ -18665,7 +18690,13 @@ fi
   fi
   { $as_echo "$as_me:${as_lineno-$LINENO}: checking which semaphore API to use" >&5
 $as_echo_n "checking which semaphore API to use... " >&6; }
-  if test x"$USE_NAMED_POSIX_SEMAPHORES" = x"1" ; then
+  if test "$enable_appstore" = yes ; then
+
+$as_echo "#define USE_PTHREAD_SEMAPHORES 1" >>confdefs.h
+
+    SEMA_IMPLEMENTATION="src/backend/port/pthread_sema.c"
+    sematype="pthread"
+  elif test x"$USE_NAMED_POSIX_SEMAPHORES" = x"1" ; then
 
 $as_echo "#define USE_NAMED_POSIX_SEMAPHORES 1" >>confdefs.h
 
