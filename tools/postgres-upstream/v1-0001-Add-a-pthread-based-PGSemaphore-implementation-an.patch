+PGAC_ARG_BOOL(enable, appstore, no, [build without System V IPC, for the macOS App Sandbox],
+              [AC_DEFINE([APPSTORE], 1,
+                         [Define to 1 to build without System V IPC. (--enable-appstore)])])
+
 
 #
 # Include directories
@@ -2363,7 +2370,11 @@ if test "$PORTNAME" != "win32"; then
     AC_SEARCH_LIBS(sem_init, [rt pthread], [USE_UNNAMED_POSIX_SEMAPHORES=1])
   fi
   AC_MSG_CHECKING([which semaphore API to use])
-  if test x"$USE_NAMED_POSIX_SEMAPHORES" = x"1" ; then
+  if test "$enable_appstore" = yes ; then
+    AC_DEFINE(USE_PTHREAD_SEMAPHORES, 1, [Define to select pthread-based semaphores.])
+    SEMA_IMPLEMENTATION="src/backend/port/pthread_sema.c"
+    sematype="pthread"
+  elif test x"$USE_NAMED_POSIX_SEMAPHORES" = x"1" ; then
     AC_DEFINE(USE_NAMED_POSIX_SEMAPHORES, 1, [Define to select named POSIX semaphores.])
     SEMA_IMPLEMENTATION="src/backend/port/posix_sema.c"
     sematype="named POSIX"
