module(name = "garage_rag")

bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "bazel_env.bzl", version = "0.7.2")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2")

# buildifier (Starlark formatter) is always available — the `aspect buildifier`
# task and the format.alias in .aspect/config.axl use it regardless of lint.
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")

# Prebuilt aspect gazelle binary (no Go toolchain needed) — provides
# //tools/gazelle:gazelle, the default target for `aspect gazelle`.

bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.26")

# NB: 2.7.0's sarif_parser toolchain is missing the linux_amd64 platform key
# (breaks lint/format on Linux CI: "key sarif_parser-linux_amd64 not found").
# Stay on 2.6.0 until that's fixed upstream.
bazel_dep(name = "aspect_rules_lint", version = "2.7.1")

# bazel_skylib's native_binary backs //tools/lint's linter wrappers.
bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "llvm", version = "0.8.21")
bazel_dep(name = "platforms", version = "1.1.0")

# go preset uses rules_go directly; the lint preset needs this floor too because
# aspect_rules_lint -> rules_buf transitively pulls an ancient rules_go (0.42.0)
# whose cgo.bzl references the removed CcInfo symbol and fails to load.
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.6")
bazel_dep(name = "rules_python", version = "2.3.3")

###############################################################################
# Module extensions
###############################################################################
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14",
)
use_repo(python, "python_3_14")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:tools.lock.json")
use_repo(multitool, "multitool")

#########################
# Hermetic Python interpreter (python-build-standalone, via aspect_rules_py).
interpreters = use_extension("@aspect_rules_py//py:extensions.bzl", "python_interpreters")
interpreters.toolchain(
    python_version = "3.14",
)
use_repo(interpreters, "python_interpreters")

register_toolchains("@python_interpreters//:all")

# rules_py tools — native_build_toolchain entries used for sdist builds.
py_tools = use_extension("@aspect_rules_py//py:extensions.bzl", "py_tools")
py_tools.rules_py_tools()
use_repo(py_tools, "rules_py_tools")

register_toolchains("@rules_py_tools//:all")

#########################
# Python dependencies via uv (pyproject.toml + uv.lock), no pip/rules_python.
uv_bin = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv_bin")
uv_bin.toolchain()
use_repo(uv_bin, "uv")

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(hub_name = "pypi")
uv.project(
    hub_name = "pypi",
    lock = "//garage_python:uv.lock",
    pyproject = "//garage_python:pyproject.toml",
)

# grpcio publishes no free-threaded (cp314t) wheels, so the 3.14t build compiles its sdist. The
# pep517 build action carries none of the Apple toolchain's environment, and the cc wrapper refuses
# to run without DEVELOPER_DIR; name the selected Xcode (xcode-select -p) explicitly.
uv.override_package(
    name = "grpcio",
    env = {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer",
        "SDKROOT": "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk",
        "GRPC_PYTHON_BUILD_EXT_COMPILER_JOBS": "16",
    },
    lock = "//garage_python:uv.lock",
)

# protobuf's only native wheel is cp310-abi3, which the hub still selects for a cp314t interpreter,
# and CPython 3.14t still loads `.abi3.so`: importing google._upb._message segfaults the
# free-threaded interpreter. Drop the extension so protobuf falls back to its pure-Python backend.
uv.override_package(
    name = "protobuf",
    exclude_glob = ["google/_upb/**"],
    lock = "//garage_python:uv.lock",
)
use_repo(uv, "pypi")

register_toolchains("@uv//:all")

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")

# Hermetic bison/flex (and the m4 they run) for //ext/age's Cypher parser; macOS ships Bison 2.3.
bazel_dep(name = "rules_bison", version = "0.4.bcr.1")
bazel_dep(name = "rules_flex", version = "0.4.1")
bazel_dep(name = "rules_m4", version = "0.3.bcr.1")
bazel_dep(name = "toolchains_llvm", version = "1.9.1")
bazel_dep(name = "apple_support", version = "2.8.4")
bazel_dep(name = "rules_apple", version = "5.1.0")

# rules_apple's xcarchive tool (tools/xcarchivetool/make_xcarchive.py) extracts the app's
# zip with zipfile.extractall() and re-copies it with shutil.copytree(symlinks=False),
# both of which dereference/corrupt symlinks. This breaks any bundle that relies on real
# symlinks, e.g. our bundled Python.framework's Versions/Current, which lands as a handful
# of tiny text files instead of symlinks and makes Xcode's export/upload step reject the
# archive with "code object is not signed at all" for Python.framework.
bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_rs", version = "0.0.61")
bazel_dep(name = "rules_ruby", version = "0.28.0")

#########################
# Ruby & Bundler dependencies
ruby = use_extension("@rules_ruby//ruby:extensions.bzl", "ruby")
ruby.toolchain(
    name = "ruby",
    portable_ruby = True,
    version = "3.2.8",
)
ruby.bundle_fetch(
    name = "bundle",
    gemfile = "//docs:Gemfile",
    gemfile_lock = "//docs:Gemfile.lock",
)
use_repo(ruby, "bundle", "ruby", "ruby_toolchains")

register_toolchains("@ruby_toolchains//:all")

###############################################################################
# T O O L C H A I N S
###############################################################################

# Rust toolchain
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.92.0",
)
use_repo(toolchains, "default_rust_toolchains")

include("//ext/postgres:postgres.MODULE.bazel")
include("//ext/postgres:postgres19.MODULE.bazel")
include("//ext/pgvector:pgvector.MODULE.bazel")
include("//ext/age:age.MODULE.bazel")
include("//ext/libicu:libicu.MODULE.bazel")
include("//ext/openssl:openssl.MODULE.bazel")
include("//ext/python:python.MODULE.bazel")
include("//ext/libzlib:libzlib.MODULE.bazel")
include("//ext/llama_cpp:llama_cpp.MODULE.bazel")
include("//ext/sparkle:sparkle.MODULE.bazel")
include("//ext/leptonica:leptonica.MODULE.bazel")
include("//ext/tesseract:tesseract.MODULE.bazel")
include("//ext/libgit2:libgit2.MODULE.bazel")
include("//ext/nomic_embed:nomic_embed.MODULE.bazel")
include("//winapp:winapp.MODULE.bazel")

bazel_dep(name = "protobuf", version = "36.2")
