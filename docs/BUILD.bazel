load("//bazel:jekyll.bzl", "jekyll_site")

filegroup(
    name = "sources",
    srcs = glob(
        ["**/*"],
        exclude = [
            "BUILD.bazel",
            "BUILD",
            "Gemfile",
            "Gemfile.lock",
            "_config.yml",
            # Copied in from //data/models (site_files); `bazel run //:site` leaves a copy here.
            ".data/models.json",
        ],
    ),
)

jekyll_site(
    name = "site",
    srcs = [":sources"],
    config = "_config.yml",
    jekyll = "@bundle//bin:jekyll",
    # The model catalog lives in //data/models; the site serves a copy (https://garagerag.app/.data/models.json).
    # .github/workflows/jekyll-gh-pages.yml makes the same copy for the published site.
    site_files = {"//data/models": ".data/models.json"},
    visibility = ["//visibility:public"],
)

# Served from the site under /.data/ (https://garagerag.app/.data/...), and bundled into the app.
filegroup(
    name = "config_schema",
    srcs = [".data/garage.schema.json"],
    visibility = ["//visibility:public"],
)

# The Sparkle feed (served as https://garagerag.app/appcast.xml) and the domain it is served
# from, for the test that checks its entries.
filegroup(
    name = "appcast",
    srcs = [
        "CNAME",
        "appcast.xml",
    ],
    visibility = ["//garage_python/tests:__pkg__"],
)
