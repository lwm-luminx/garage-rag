http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# psycopg's C implementation, from its sdist, which carries the Cython output (`pq.c`, `_psycopg.c`),
# so the build needs no Cython. Its version must be psycopg's in garage_python/uv.lock: psycopg calls
# into it with the signatures of its own release (tests/test_psycopg_c.py holds the two together).
http_archive(
    name = "psycopg_c",
    build_file = "@//ext/psycopg_c:psycopg_c.BUILD.bazel",
    sha256 = "ed8106128b2d04359c185fc9641b4409abfce4d0b6fb1d1ff6800646e27f1a22",
    strip_prefix = "psycopg_c-3.3.4",
    urls = ["https://files.pythonhosted.org/packages/source/p/psycopg-c/psycopg_c-3.3.4.tar.gz"],
)
