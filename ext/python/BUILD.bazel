load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_apple//apple:apple.bzl", "apple_dynamic_framework_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("//bazel:codesign.bzl", "EXPECTED_SIGNING_IDENTITY", "HARDENED_RUNTIME_EXPECTED", "STORE_EXPECTED", "codesign", "codesign_test")
load("//bazel:signing.bzl", "STORE_IDENTITY")

configure_make(
    name = "python_3_14t",
    args = [
        "-e",
    ],
    # _garage_git: garage_git.patch adds it to Modules/Setup.local as a static built-in module
    # (libpython, so Python.framework's own binary) and passes Setup.local's libraries to the
    # framework link. Its source is garage_git/garage_git.c, and libgit2 is linked in statically,
    # so git history needs nothing loaded at run time. _garage_tesseract (garage_tesseract.patch,
    # garage_tesseract/garage_tesseract.c) does the same for OCR with Tesseract and Leptonica,
    # which are C++ and so bring libc++. make reads these from the environment.
    build_data = [
        "garage_git/garage_git.c",
        "garage_tesseract/garage_tesseract.c",
    ],
    configure_in_place = True,
    configure_options = [
        "--enable-framework=$$INSTALLDIR$$/",
        "--without-ensurepip",
        # Free-threaded (PEP 703) build: the 3.14t ABI, lib/python3.14t, include/python3.14t.
        "--disable-gil",
        "--with-static-libpython",
        "--with-openssl=$$EXT_BUILD_DEPS/openssl",
        # libedit (BSD, in the macOS SDK), not GNU Readline (GPL-3.0).
        "--with-readline=editline",
    ],
    copts = [
        "-DDATE=\\\"\\\\\\\"Jan_01_1970\\\\\\\"\\\"",
        "-DTIME=\\\"\\\\\\\"00:00:00\\\\\\\"\\\"",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "ARFLAGS": "crs",
        "MODULE__GARAGE_GIT_CFLAGS": "-I$$EXT_BUILD_ROOT$$/ext/python/garage_git -I$$EXT_BUILD_DEPS$$/libgit2/include",
        "MODULE__GARAGE_GIT_LDFLAGS": "$$EXT_BUILD_DEPS$$/libgit2/lib/libgit2.a -lz -liconv",
        "MODULE__GARAGE_TESSERACT_CFLAGS": "-I$$EXT_BUILD_ROOT$$/ext/python/garage_tesseract -I$$EXT_BUILD_DEPS$$/tesseract/include",
        "MODULE__GARAGE_TESSERACT_LDFLAGS": "$$EXT_BUILD_DEPS$$/tesseract/lib/libtesseract.a $$EXT_BUILD_DEPS$$/leptonica/lib/libleptonica.a -lc++",
        "PYTHONAPPSDIR": "$$INSTALLDIR$$/",
    },
    lib_source = "@python_source//:python_source",
    out_binaries = [
        "python3",
        "python3-config",
    ],
    out_data_dirs = [
        "Python.framework",
        "bin/python3.dSYM",
    ],
    postfix_script = """
for f in $$INSTALLDIR/bin/*; do
    if [ -f "$$f" ] && [ -x "$$f" ]; then
        dsymutil "$$f" -o "$$f.dSYM" || true
    fi
done
find $$INSTALLDIR/Python.framework -type f \\( -perm -111 -o -name "*.dylib" -o -name "*.so" \\) 2>/dev/null | while IFS= read -r f; do
    if file -b "$$f" | grep -q "Mach-O"; then
        dsymutil "$$f" -o "$$f.dSYM" || true
    fi
done
""",
    # Build in parallel, install serially: CPython's framework install races under any
    # parallel make (frameworkinstallmaclib symlinks into config-3.14t-darwin before that
    # directory exists), which fails every time at -j2.
    targets = [
        "",
        "install -j1",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//ext:libzlib",
        "//ext:openssl",
        "//ext/leptonica",
        "//ext/libgit2",
        "//ext/tesseract",
    ],
)

# Raw install tree of the framework build (Python.framework/, bin/, include/).
filegroup(
    name = "python_3_14t_install_dir",
    srcs = [":python_3_14t"],
    output_group = "gen_dir",
)

# Header-only target exposing <Python.h> from the framework build so that host
# code can use the PyConfig embedding API. It deliberately does NOT link
# libpython: consumers link `-framework Python` (the bundled Python.framework)
# so exactly one interpreter is present in the process.
cc_library(
    name = "python_headers",
    hdrs = [":python_3_14t_install_dir"],
    includes = ["copy_python_3_14t/python_3_14t/Python.framework/Versions/3.14/include/python3.14t"],
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "python_framework_raw",
    srcs = [":python_3_14t"],
    out = "python_framework_raw",
    exclude_srcs_patterns = [
        "**/Versions/*/lib/**",
        "**/Versions/*/lib",
        "**/Versions/3.14/lib/**",
        "**/Versions/3.14/lib",
        "**/Versions/Current/lib/**",
        "**/Versions/Current/lib",
        "**/lib/**",
        "**/lib",
        # The bin/ directory (python3, idle3, pydoc3, python3-config, ...) isn't
        # needed at runtime — GaragePythonEmbed links libpython directly via
        # PyConfig — and App Store review flags bundled command-line
        # interpreters/tools inside a framework, so drop it before signing.
        "**/Versions/*/bin/**",
        "**/Versions/*/bin",
        "**/Versions/3.14/bin/**",
        "**/Versions/3.14/bin",
        "**/Versions/Current/bin/**",
        "**/Versions/Current/bin",
        "**/bin/**",
        "**/bin",
    ],
    include_srcs_patterns = [
        "python_3_14t/Python.framework/**",
    ],
    replace_prefixes = {
        "python_3_14t": "",
    },
)

codesign(
    name = "python_framework",
    src = ":python_framework_raw",
    out = "Python.framework",
    framework_as_directory = select({
        "//bazel:tree_artifact_outputs": True,
        "//conditions:default": False,
    }),
    is_framework = True,
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)

apple_dynamic_framework_import(
    name = "Python",
    framework_imports = [":python_framework"],
    visibility = ["//visibility:public"],
)

alias(
    name = "python_framework_import",
    actual = ":Python",
    visibility = ["//visibility:public"],
)

codesign_test(
    name = "python_framework_codesign_test",
    src = ":python_framework",
    hardened_runtime = HARDENED_RUNTIME_EXPECTED,
    is_store = STORE_EXPECTED,
    signing_identity = EXPECTED_SIGNING_IDENTITY,
)
