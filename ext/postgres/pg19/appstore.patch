diff --git a/src/test/modules/test_misc/t/016_orphan_interlock.pl b/src/test/modules/test_misc/t/016_orphan_interlock.pl
new file mode 100644
index 0000000..3704dbc
--- /dev/null
+++ b/src/test/modules/test_misc/t/016_orphan_interlock.pl
@@ -0,0 +1,82 @@
+# Copyright (c) 2026, PostgreSQL Global Development Group
+
+# The data directory interlock: a postmaster must refuse to start while a
+# child of a previous, crashed postmaster is still attached to that
+# postmaster's shared memory.  With System V shared memory the check reads
+# shm_nattch of the segment named in postmaster.pid; an APPSTORE build asks
+# for an exclusive lock on postmaster.pid instead.  Either way the observable
+# behavior is the same, so this test covers both.
+
+use strict;
+use warnings FATAL => 'all';
+
+use PostgreSQL::Test::Cluster;
+use PostgreSQL::Test::Utils;
+use Test::More;
+use Time::HiRes qw(usleep);
+
+if ($windows_os)
+{
+	plan skip_all => 'test needs kill(2) with SIGSTOP and SIGKILL';
+}
+
+my $node = PostgreSQL::Test::Cluster->new('primary');
+$node->init;
+$node->start;
+
+# A backend that will outlive its postmaster.  Freeze it with SIGSTOP so it
+# neither finishes nor notices that the postmaster is gone.
+my $session = $node->background_psql('postgres');
+my $backend_pid = $session->query_safe('SELECT pg_backend_pid()');
+like($backend_pid, qr/^\d+$/, 'got a backend PID');
+ok(kill('STOP', $backend_pid), 'froze the backend');
+
+# Crash the postmaster.  Its other children notice and exit; the frozen
+# backend stays attached to the old shared memory.
+my $postmaster_pid = $node->{_pid};
+$node->kill9;
+
+# Wait for the postmaster to be reaped and its ordinary children to go away,
+# so that only the orphan is left holding the interlock.
+for (my $i = 0; $i < 100 && kill(0, $postmaster_pid); $i++)
+{
+	usleep(100_000);
+}
+ok(!kill(0, $postmaster_pid), 'postmaster is gone');
+usleep(500_000);
+
+# A new postmaster must refuse to start.
+my $logstart = -s $node->logfile;
+ok(!$node->start(fail_ok => 1),
+	'postmaster refuses to start over an orphaned backend');
+my $log = slurp_file($node->logfile, $logstart);
+like(
+	$log,
+	qr/pre-existing shared memory block .* is still in use/,
+	'start failed with the interlock message');
+like(
+	$log,
+	qr/Terminate any old server processes associated with data directory/,
+	'and the usual hint');
+
+# Kill the orphan; now the start must succeed and run crash recovery.
+ok(kill('KILL', $backend_pid), 'killed the orphaned backend');
+kill('CONT', $backend_pid);
+for (my $i = 0; $i < 100 && kill(0, $backend_pid); $i++)
+{
+	usleep(100_000);
+}
+ok(!kill(0, $backend_pid), 'orphaned backend is gone');
+
+$logstart = -s $node->logfile;
+$node->start;
+$log = slurp_file($node->logfile, $logstart);
+like($log, qr/database system was interrupted/, 'crash recovery ran');
+is($node->safe_psql('postgres', 'SELECT 1'), '1', 'new postmaster serves queries');
+
+# The background psql client was left hanging on its query; the backend's
+# death will have ended it.
+$session->{run}->kill_kill if $session->{run};
+
+$node->stop;
+done_testing();
