diff --git a/src/backend/port/pthread_sema.c b/src/backend/port/pthread_sema.c
new file mode 100644
index 0000000..1dc97f4
--- /dev/null
+++ b/src/backend/port/pthread_sema.c
@@ -0,0 +1,269 @@
+/*-------------------------------------------------------------------------
+ *
+ * pthread_sema.c
+ *	  Implement PGSemaphores using process-shared pthread primitives
+ *
+ * This is a counting semaphore built from a PTHREAD_PROCESS_SHARED mutex,
+ * a condition variable and a counter, all living in an array in the main
+ * shared memory segment.  It exists for platforms that provide neither
+ * System V semaphores (or forbid them, as the macOS App Sandbox does) nor
+ * unnamed POSIX semaphores (sem_init is unimplemented on Darwin), and where
+ * named POSIX semaphores are unattractive because they cost a file
+ * descriptor per backend per semaphore.
+ *
+ * Because the semaphores live in shared memory, this implementation works
+ * with fork()ed and exec()ed backends alike.  Nothing here needs a kernel
+ * object name, so it works under sandboxes that restrict the IPC namespace.
+ *
+ * Semaphore waits are not interruptible by signals, which matches the other
+ * implementations: they retry on EINTR and never service interrupts from
+ * inside a semaphore wait (see the comments in sysv_sema.c).
+ *
+ * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
+ * Portions Copyright (c) 1994, Regents of the University of California
+ *
+ * IDENTIFICATION
+ *	  src/backend/port/pthread_sema.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include <pthread.h>
+
+#include "miscadmin.h"
+#include "storage/ipc.h"
+#include "storage/pg_sema.h"
+#include "storage/shmem.h"
+
+
+typedef struct PGSemaphoreData
+{
+	pthread_mutex_t mutex;
+	pthread_cond_t cond;
+	int			count;
+} PGSemaphoreData;
+
+/* Pad each semaphore to a cache line, as posix_sema.c does for sem_t */
+typedef union PGSemaphorePadded
+{
+	PGSemaphoreData sema;
+	char		pad[PG_CACHE_LINE_SIZE];
+} PGSemaphorePadded;
+
+static PGSemaphorePadded *sharedSemas;	/* array in shared memory */
+static int	numSems;			/* number of semas created so far */
+static int	maxSems;			/* allocated size of the array */
+
+static void ReleaseSemaphores(int status, Datum arg);
+
+
+/*
+ * Request shared memory needed for semaphores
+ */
+void
+PGSemaphoreShmemRequest(int maxSemas)
+{
+	ShmemRequestStruct(.name = "Semaphores",
+					   .size = mul_size(maxSemas, sizeof(PGSemaphorePadded)),
+					   .ptr = (void **) &sharedSemas,
+		);
+}
+
+/*
+ * PGSemaphoreInit --- initialize semaphore support
+ *
+ * This is called during postmaster start or shared memory reinitialization.
+ * The semaphores themselves are created on demand by PGSemaphoreCreate; the
+ * maxSemas parameter only sizes the array, which PGSemaphoreShmemRequest
+ * already placed in shared memory.
+ */
+void
+PGSemaphoreInit(int maxSemas)
+{
+	numSems = 0;
+	maxSems = maxSemas;
+
+	on_shmem_exit(ReleaseSemaphores, 0);
+}
+
+/*
+ * Release semaphores at shutdown or shmem reinitialization
+ *
+ * (called as an on_shmem_exit callback, hence funny argument list)
+ *
+ * The primitives own no kernel resources; destroying them is a formality
+ * that keeps the memory consistent for a shared memory reinitialization
+ * after a backend crash.  A mutex a crashed backend still held is simply
+ * discarded with the mapping.
+ */
+static void
+ReleaseSemaphores(int status, Datum arg)
+{
+	int			i;
+
+	for (i = 0; i < numSems; i++)
+	{
+		(void) pthread_mutex_destroy(&sharedSemas[i].sema.mutex);
+		(void) pthread_cond_destroy(&sharedSemas[i].sema.cond);
+	}
+	numSems = 0;
+}
+
+/*
+ * PGSemaphoreCreate
+ *
+ * Allocate a PGSemaphore structure with initial count 1
+ */
+PGSemaphore
+PGSemaphoreCreate(void)
+{
+	PGSemaphore sema;
+	pthread_mutexattr_t mattr;
+	pthread_condattr_t cattr;
+	int			rc;
+
+	/* Can't do this in a backend, because static state is postmaster's */
+	Assert(!IsUnderPostmaster);
+
+	if (numSems >= maxSems)
+		elog(PANIC, "too many semaphores created");
+
+	sema = &sharedSemas[numSems].sema;
+
+	if ((rc = pthread_mutexattr_init(&mattr)) != 0 ||
+		(rc = pthread_mutexattr_setpshared(&mattr, PTHREAD_PROCESS_SHARED)) != 0 ||
+		(rc = pthread_mutex_init(&sema->mutex, &mattr)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "could not initialize process-shared mutex: %m");
+	}
+	(void) pthread_mutexattr_destroy(&mattr);
+
+	if ((rc = pthread_condattr_init(&cattr)) != 0 ||
+		(rc = pthread_condattr_setpshared(&cattr, PTHREAD_PROCESS_SHARED)) != 0 ||
+		(rc = pthread_cond_init(&sema->cond, &cattr)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "could not initialize process-shared condition variable: %m");
+	}
+	(void) pthread_condattr_destroy(&cattr);
+
+	sema->count = 1;
+
+	numSems++;
+
+	return sema;
+}
+
+/*
+ * PGSemaphoreReset
+ *
+ * Reset a previously-initialized PGSemaphore to have count 0
+ */
+void
+PGSemaphoreReset(PGSemaphore sema)
+{
+	int			rc;
+
+	if ((rc = pthread_mutex_lock(&sema->mutex)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_mutex_lock failed: %m");
+	}
+	sema->count = 0;
+	if ((rc = pthread_mutex_unlock(&sema->mutex)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_mutex_unlock failed: %m");
+	}
+}
+
+/*
+ * PGSemaphoreLock
+ *
+ * Lock a semaphore (decrement count), blocking if count would be < 0
+ */
+void
+PGSemaphoreLock(PGSemaphore sema)
+{
+	int			rc;
+
+	if ((rc = pthread_mutex_lock(&sema->mutex)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_mutex_lock failed: %m");
+	}
+	while (sema->count <= 0)
+	{
+		if ((rc = pthread_cond_wait(&sema->cond, &sema->mutex)) != 0)
+		{
+			errno = rc;
+			elog(FATAL, "pthread_cond_wait failed: %m");
+		}
+	}
+	sema->count--;
+	if ((rc = pthread_mutex_unlock(&sema->mutex)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_mutex_unlock failed: %m");
+	}
+}
+
+/*
+ * PGSemaphoreUnlock
+ *
+ * Unlock a semaphore (increment count)
+ */
+void
+PGSemaphoreUnlock(PGSemaphore sema)
+{
+	int			rc;
+
+	if ((rc = pthread_mutex_lock(&sema->mutex)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_mutex_lock failed: %m");
+	}
+	sema->count++;
+	if ((rc = pthread_cond_signal(&sema->cond)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_cond_signal failed: %m");
+	}
+	if ((rc = pthread_mutex_unlock(&sema->mutex)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_mutex_unlock failed: %m");
+	}
+}
+
+/*
+ * PGSemaphoreTryLock
+ *
+ * Lock a semaphore only if able to do so without blocking
+ */
+bool
+PGSemaphoreTryLock(PGSemaphore sema)
+{
+	bool		result = false;
+	int			rc;
+
+	if ((rc = pthread_mutex_lock(&sema->mutex)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_mutex_lock failed: %m");
+	}
+	if (sema->count > 0)
+	{
+		sema->count--;
+		result = true;
+	}
+	if ((rc = pthread_mutex_unlock(&sema->mutex)) != 0)
+	{
+		errno = rc;
+		elog(FATAL, "pthread_mutex_unlock failed: %m");
+	}
+
+	return result;
+}
diff --git a/src/backend/port/sysv_shmem.c b/src/backend/port/sysv_shmem.c
index 2e3886c..441238f 100644
--- a/src/backend/port/sysv_shmem.c
+++ b/src/backend/port/sysv_shmem.c
@@ -19,6 +19,7 @@
  */
 #include "postgres.h"
 
+#include <fcntl.h>
 #include <signal.h>
 #include <unistd.h>
 #include <sys/file.h>
@@ -65,8 +66,43 @@
  * As of PostgreSQL 12, we regained the ability to use a large System V shared
  * memory region even in non-EXEC_BACKEND builds, if shared_memory_type is set
  * to sysv (though this is not the default).
+ *
+ * An APPSTORE build (--enable-appstore / -Dappstore=true) is for platforms
+ * where System V IPC is unavailable altogether, such as the macOS App Sandbox,
+ * which denies shmget() and semget() to a sandboxed process.  There the
+ * segment is always anonymous mmap() memory, and the interlock that the SysV
+ * shim provided through shm_nattch is provided by a shared flock() on the data
+ * directory itself instead: the postmaster takes the lock before it forks its
+ * first child, every child inherits the descriptor and therefore the lock, and
+ * a later postmaster asks for an exclusive lock first; if that fails, some
+ * child of the dead postmaster is still alive and still attached to the old
+ * shared memory.  Locking the directory rather than postmaster.pid means that
+ * removing the lock file by hand does not defeat the check, just as it does
+ * not defeat the SysV one.  The lock lives on the open file description, so it
+ * survives fork() and exec() and disappears only when the last process holding
+ * the descriptor exits.  Anonymous memory cannot be re-attached after exec(),
+ * so EXEC_BACKEND is not supported.
  */
 
+#ifdef APPSTORE
+
+#ifdef EXEC_BACKEND
+#error APPSTORE builds cannot use EXEC_BACKEND
+#endif
+
+unsigned long UsedShmemSegID = 0;
+void	   *UsedShmemSegAddr = NULL;
+
+static Size AnonymousShmemSize;
+static void *AnonymousShmem = NULL;
+
+/* Descriptor on the data directory that carries our shared lock */
+static int	InterlockFd = -1;
+
+static void InterlockAcquire(void);
+static void InterlockRelease(int status, Datum arg);
+
+#else							/* !APPSTORE */
 
 typedef key_t IpcMemoryKey;		/* shared memory key passed to shmget(2) */
 typedef int IpcMemoryId;		/* shared memory ID returned by shmget(2) */
@@ -454,6 +490,142 @@ PGSharedMemoryAttach(IpcMemoryId shmId,
 	return shmStat.shm_nattch == 0 ? SHMSTATE_UNATTACHED : SHMSTATE_ATTACHED;
 }
 
+#endif							/* !APPSTORE */
+
+#ifdef APPSTORE
+
+/*
+ * InterlockProbe
+ *
+ * Open the data directory and try for an exclusive lock on it.  Returns the
+ * descriptor, still exclusively locked, if nobody else holds the directory;
+ * returns -1 with errno set if a process of an earlier postmaster still does
+ * (EWOULDBLOCK) or if the attempt failed for another reason.
+ */
+static int
+InterlockProbe(void)
+{
+	int			fd;
+
+	fd = open(DataDir, O_RDONLY | PG_BINARY, 0);
+	if (fd < 0)
+		return -1;
+
+	if (flock(fd, LOCK_EX | LOCK_NB) < 0)
+	{
+		int			save_errno = errno;
+
+		close(fd);
+		errno = save_errno;
+		return -1;
+	}
+
+	return fd;
+}
+
+/*
+ * InterlockAcquire
+ *
+ * Take a shared lock on the data directory and keep the descriptor open for
+ * the life of the postmaster.  Children inherit the descriptor, and with it
+ * the lock, across fork().  The descriptor must not be close-on-exec
+ * (EXEC_BACKEND is refused above anyway) and must never be closed by a child
+ * that still has the shared memory mapped.
+ *
+ * We first ask for an exclusive lock, which fails while a child of an earlier
+ * postmaster is still alive; this is what catches the case where somebody
+ * removed postmaster.pid, so CreateLockFile never got to ask.  Then we
+ * downgrade to a shared lock.  CreateDataDirLockFile() keeps two postmasters
+ * from racing through here at once.
+ *
+ * A shared memory reinitialization after a crash releases and reacquires the
+ * lock; no child exists at that point.
+ */
+static void
+InterlockAcquire(void)
+{
+	int			fd;
+
+	if (InterlockFd >= 0)
+		return;
+
+	fd = InterlockProbe();
+	if (fd < 0)
+	{
+		if (errno == EWOULDBLOCK)
+			ereport(FATAL,
+					(errcode(ERRCODE_LOCK_FILE_EXISTS),
+					 errmsg("pre-existing shared memory block is still in use"),
+					 errhint("Terminate any old server processes associated with data directory \"%s\".",
+							 DataDir)));
+		ereport(FATAL,
+				(errcode_for_file_access(),
+				 errmsg("could not lock data directory \"%s\": %m",
+						DataDir)));
+	}
+
+	if (flock(fd, LOCK_SH) < 0)
+		ereport(FATAL,
+				(errcode_for_file_access(),
+				 errmsg("could not lock data directory \"%s\": %m",
+						DataDir)));
+
+	InterlockFd = fd;
+	on_shmem_exit(InterlockRelease, (Datum) 0);
+}
+
+/*
+ * InterlockRelease
+ *
+ * Drop our shared lock.  Called as an on_shmem_exit callback, hence the
+ * funny argument list, and from PGSharedMemoryDetach for children that let
+ * go of shared memory.
+ */
+static void
+InterlockRelease(int status, Datum arg)
+{
+	if (InterlockFd >= 0)
+	{
+		if (close(InterlockFd) < 0)
+			elog(LOG, "could not close data directory \"%s\": %m", DataDir);
+		InterlockFd = -1;
+	}
+}
+
+/*
+ * PGSharedMemoryIsInUse
+ *
+ * Is a previously-existing shmem segment still existing and in use?
+ *
+ * Called by CreateLockFile when it finds a postmaster.pid whose postmaster
+ * is dead, before it unlinks the file.  The ids from line 7 of the file mean
+ * nothing here; what tells us whether orphaned children of that postmaster
+ * are still attached to its shared memory is whether they still hold the
+ * shared lock on the data directory.  An exclusive lock attempt fails
+ * exactly then.
+ */
+bool
+PGSharedMemoryIsInUse(unsigned long id1, unsigned long id2)
+{
+	int			fd;
+
+	fd = InterlockProbe();
+	if (fd >= 0)
+	{
+		close(fd);
+		return false;
+	}
