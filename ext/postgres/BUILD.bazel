load(":postgres.bzl", "postgres_targets")

# The bundled PostgreSQL, one package for every major version: --//ext:postgres_version picks
# the source (18 by default, 19 with --config=pg19), and each version's patches live in
# pg<major>/ beside this file, like //ext/age's release lines.
postgres_targets(
    name = "postgres",
    lib_source = select({
        "//ext:postgres_19": "@postgres19//:postgres_source",
        "//conditions:default": "@postgres//:postgres_source",
    }),
)
