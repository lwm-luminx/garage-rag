load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

# Static libtesseract, linked with //ext/leptonica into the app's Python for its built-in
# _garage_tesseract module (see //ext/python): garage_rag.extract.tesseract reads images through its
# C API (capi.h) in-process, with no dylib loaded at run time.
cmake(
    name = "tesseract",
    build_args = [
        "--",
        "-j",
    ],
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_TRAINING_TOOLS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        # Linked into Python.framework's dylib.
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "DISABLE_ARCHIVE": "ON",
        "DISABLE_CURL": "ON",
        "DISABLE_TIFF": "ON",
        "ENABLE_LTO": "OFF",
        "GRAPHICS_DISABLED": "ON",
        "INSTALL_CONFIGS": "OFF",
        "Leptonica_DIR": "$$EXT_BUILD_DEPS/leptonica/lib/cmake/leptonica",
        "OPENMP_BUILD": "OFF",
    },
    # Pin `cmake --build/--install --config` to CMAKE_BUILD_TYPE. Left unset, rules_foreign_cc
    # passes `--config Debug` under compilation_mode=dbg (the rules_xcodeproj build), and the
    # install then skips the Release-only `*Targets-release.cmake` export.
    configuration = "Release",
    env = {
        "AR": "/usr/bin/ar",
        # //ext/leptonica has no codecs, so two things that would use one are switched off:
        # DebugPixa's caption fonts (TIFF-encoded; four "Error in pixReadMemTiff" lines
        # per image) and ImageData encoding each text line to PNG in memory before the
        # LSTM reads it back (falls back to PNM with a warning). Keeping the line as a Pix
        # skips the encode/decode round trip as well.
        "CXXFLAGS": "-DTESSERACT_DISABLE_DEBUG_FONTS -DTESSERACT_IMAGEDATA_AS_PIX",
    },
    lib_source = "@tesseract//:tesseract_source",
    out_static_libs = ["libtesseract.a"],
    visibility = ["//visibility:public"],
    deps = ["//ext/leptonica"],
)

filegroup(
    name = "tessdata",
    srcs = ["@tessdata_eng//file"],
    visibility = ["//visibility:public"],
)
