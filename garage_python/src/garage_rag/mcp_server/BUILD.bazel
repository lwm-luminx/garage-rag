load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")

py_binary(
    name = "garage-mcp",
    srcs = [
        "agent.py",
        "server.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        # Owns garage_rag/__init__.py, whose libpq configure hook the bundled app
        # relies on; without it garage_rag is only a namespace package here.
        # Nothing in server.py imports it, so gazelle needs the keep.
        "//garage_python/src/garage_rag",  # keep
        "//garage_python/src/garage_rag/config",
        "//garage_python/src/garage_rag/db",
        "//garage_python/src/garage_rag/enrich",
        "//garage_python/src/garage_rag/net",
        "//garage_python/src/garage_rag/search",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "mcp_server",
    srcs = [
        "__init__.py",
        "agent.py",
        "install.py",
        "server.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//garage_python/src/garage_rag/config",
        "//garage_python/src/garage_rag/db",
        "//garage_python/src/garage_rag/enrich",
        "//garage_python/src/garage_rag/net",
        "//garage_python/src/garage_rag/search",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
        "@pypi//uvicorn",
    ],
)
