load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_bazel_lib//lib:output_files.bzl", "output_files")

copy_to_directory(
    name = "sql_schema",
    srcs = glob(["*.sql"]),
    out = "sql",
    visibility = ["//visibility:public"],
)

# The access policies' DDL, which garage-access-rego also applies itself (include_str!).
exports_files(
    ["027_access_policies.sql"],
    visibility = ["//rust/garage-access-rego:__pkg__"],
)
