load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_swift//proto:proto.bzl", "swift_proto_library")

# The Windows app's C# is generated from the file itself (//winapp/bazel:proto.bzl), with the
# protoc Grpc.Tools ships, as its .NET SDK build does.
exports_files(
    [
        "garage.proto",
        "garage_plugin.proto",
    ],
    visibility = ["//winapp:__subpackages__"],
)

proto_library(
    name = "garage_proto",
    srcs = ["garage.proto"],
    visibility = ["//visibility:public"],
)

swift_proto_library(
    name = "garage_proto_swift",
    compilers = [
        "@rules_swift//proto/compilers:swift_proto",
        "@rules_swift//proto/compilers:swift_client_proto",
    ],
    protos = [":garage_proto"],
    visibility = ["//visibility:public"],
)

py_proto_library(
    name = "garage_proto_py",
    visibility = ["//visibility:public"],
    deps = [":garage_proto"],
)

# The contract between the ingester and its reader plugins. Rust's code is generated by
# rust/protogen and checked in, as Python's is (garage_rag/proto/garage_plugin_pb2*.py).
proto_library(
    name = "garage_plugin_proto",
    srcs = ["garage_plugin.proto"],
    visibility = ["//visibility:public"],
)

swift_proto_library(
    name = "garage_plugin_proto_swift",
    module_name = "GaragePluginProto",
    protos = [":garage_plugin_proto"],
    visibility = ["//visibility:public"],
)

py_proto_library(
    name = "garage_plugin_proto_py",
    visibility = ["//visibility:public"],
    deps = [":garage_plugin_proto"],
)
