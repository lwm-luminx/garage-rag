load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The ingest pipeline's pieces moved out of Python (garage_rag/ingest, extract/quality.py and
# attribute/), with git history read through //rust/garage-git.
rust_library(
    name = "garage-ingest",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_ingest",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//rust/garage-facade",
        "//rust/garage-git",
        "@crates//:libc",
        "@crates//:regex",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "garage-ingest-test",
    crate = ":garage-ingest",
)
