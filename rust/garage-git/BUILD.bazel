load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# //ext/libgit2 (static, local reads only) with the system libraries it needs: zlib, and iconv on
# macOS. Cargo builds find libgit2 in build.rs.
cc_library(
    name = "libgit2_linked",
    linkopts = ["-lz"] + select({
        "@platforms//os:macos": ["-liconv"],
        "//conditions:default": [],
    }),
    deps = ["//ext/libgit2"],
)

# A repository's history, origin remote and index read in-process, as _garage_git reads them.
rust_library(
    name = "garage-git",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_git",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":libgit2_linked"],
)

rust_test(
    name = "garage-git-test",
    crate = ":garage-git",
)
