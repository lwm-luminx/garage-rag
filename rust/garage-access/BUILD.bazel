load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The access hooks (docs/plans/access-hooks.md): Caller, the AccessPolicy trait and its registry.
rust_library(
    name = "garage-access",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_access",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:bytes",
        "@crates//:tokio-postgres",
    ],
)

rust_test(
    name = "garage-access-test",
    crate = ":garage-access",
)

# The library linked as `garage_access_extension`, whose `register` adds the build's policy. A
# plain build links //rust/garage-access-none, which adds none; garage-enterprise sets
# --@garage_rag//rust/garage-access:extension to its own. It is a link-time choice, so nothing is
# loaded at run time and no configuration file can name an extension.
label_flag(
    name = "extension",
    build_setting_default = "//rust/garage-access-none",
    visibility = ["//visibility:public"],
)
