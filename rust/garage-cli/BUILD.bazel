load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

_DEPS = [
    "//rust/garage-embed",
    "//rust/garage-facade",
    "//rust/garage-ingest",
    "//rust/garage-ingest-ffi:garage_ingest_ffi_lib",
    "//rust/garage-mcp",
    "//rust/garage-readers",
    "//rust/garage-service",
    "@crates//:libc",
    "@crates//:serde_json",
    "@crates//:tokio",
    "@crates//:tonic",
]

# The `garage` CLI and the `garage-mcp` stdio server behind their C mains (include/garage_cli.h),
# linked statically into the launcher helpers (//macapp/Sources/GarageLauncher).
rust_static_library(
    name = "garage_cli_static",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "garage_cli",
    edition = "2024",
    deps = _DEPS,
)

# The system libraries the static library's dependencies need, which a Rust static library does not
# carry to its linker: zlib and iconv for libgit2 (//rust/garage-git links them for a Rust binary),
# and SystemConfiguration on macOS for `whoami`, which tokio-postgres reads the default user with. The XPC
# services get them from their frameworks; the launcher helpers link nothing else.
cc_library(
    name = "garage-cli",
    hdrs = ["include/garage_cli.h"],
    includes = ["include"],
    linkopts = ["-lz"] + select({
        "@platforms//os:macos": [
            "-liconv",
            "-framework",
            "SystemConfiguration",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":garage_cli_static"],
)

rust_library(
    name = "garage_cli_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "garage_cli",
    edition = "2024",
    visibility = ["//rust/garage-cli-uniffi:__pkg__"],
    deps = _DEPS,
)

rust_test(
    name = "garage-cli-test",
    crate = ":garage_cli_lib",
)
