load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

_DEPS = [
    "//rust/garage-embed",
    "//rust/garage-mcp",
    "@crates//:serde_json",
]

# The MCP server behind its C ABI (include/garage_mcp.h), linked statically into the MCP
# service.
rust_static_library(
    name = "garage_mcp_ffi_static",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_mcp_ffi",
    edition = "2024",
    deps = _DEPS,
)

cc_library(
    name = "garage-mcp-ffi",
    hdrs = ["include/garage_mcp.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [":garage_mcp_ffi_static"],
)

rust_library(
    name = "garage_mcp_ffi_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_mcp_ffi",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "garage-mcp-ffi-test",
    crate = ":garage_mcp_ffi_lib",
)
