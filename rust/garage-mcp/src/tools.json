 {
  "description": "Answer a question by letting the local model search and read the corpus itself.\n\nThe model named by facts.model on facts.provider gets this server's read-only\ntools (rag_search, rag_get_document, rag_list_sources, rag_list_authors,\nrag_stats) to call, in a loop, until it answers; the result carries the\nanswer, the steps it took and the documents it saw. By default the question is\nsearched first and the model starts from those hits. Use rag_ask for one\nretrieval and a cited answer, rag_agent when the question needs more than one\nlook. Runs on the local model, so nothing leaves the machine; an off-box\nOllama or LM Studio host never receives a communication.\n",
  "inputSchema": {
   "properties": {
    "question": {
     "description": "Natural-language question to answer from the corpus.",
     "title": "Question",
     "type": "string"
    },
    "max_steps": {
     "default": 6,
     "description": "Tool calls the model may make before it has to answer.",
     "maximum": 12,
     "minimum": 1,
     "title": "Max Steps",
     "type": "integer"
    },
    "max_tokens": {
     "default": 768,
     "description": "Cap on each model reply.",
     "maximum": 4096,
     "minimum": 16,
     "title": "Max Tokens",
     "type": "integer"
    },
    "temperature": {
     "default": 0.2,
     "description": "Sampling temperature.",
     "maximum": 2.0,
     "minimum": 0.0,
     "title": "Temperature",
     "type": "number"
    },
    "search_first": {
     "default": true,
     "description": "Search the corpus for the question before the model's first reply, so a small model starts from the user's documents instead of answering from its training.",
     "title": "Search First",
     "type": "boolean"
    }
   },
   "required": [
    "question"
   ],
   "type": "object",
   "title": "rag_agentArguments"
  },
  "name": "rag_agent",
  "outputSchema": {
   "properties": {
    "answer": {
     "title": "Answer",
     "type": "string"
    },
    "model": {
     "title": "Model",
     "type": "string"
    },
    "provider": {
     "title": "Provider",
     "type": "string"
    },
    "question": {
     "title": "Question",
     "type": "string"
    },
    "steps": {
     "items": {
