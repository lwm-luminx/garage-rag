      "n": {
       "title": "N",
       "type": "integer"
      },
      "document_id": {
       "title": "Document Id",
       "type": "integer"
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Title"
      },
      "location": {
       "title": "Location",
       "type": "string"
      },
