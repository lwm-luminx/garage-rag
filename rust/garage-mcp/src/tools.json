    },
    "completion_tokens": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Completion Tokens"
    }
   },
   "required": [
    "answer",
    "model",
    "provider",
    "question",
    "citations"
   ],
   "type": "object",
   "$defs": {
