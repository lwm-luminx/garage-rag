      },
      "score": {
       "title": "Score",
       "type": "number"
      }
     },
     "required": [
      "n",
      "document_id",
      "title",
      "location",
      "snippet",
      "score"
     ],
     "title": "Citation",
     "type": "object"
    }
   },
   "title": "AskResult"
  }
 },
