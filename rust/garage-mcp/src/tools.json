[
 {
  "description": "Search the personal corpus with hybrid semantic + keyword retrieval.\n\nFilter by trust to separate the owner's own writing from reference material,\nby corpus_class to keep source code out of prose answers, and by direction\nto keep to messages the owner sent or received.\n",
  "inputSchema": {
   "properties": {
    "query": {
     "description": "Natural-language question or keywords to search for.",
     "title": "Query",
     "type": "string"
    },
    "limit": {
     "default": 10,
     "description": "Maximum hits to return.",
     "maximum": 50,
     "minimum": 1,
     "title": "Limit",
     "type": "integer"
    },
    "mode": {
     "default": "hybrid",
     "description": "hybrid fuses semantic and keyword search (best default); vector is semantic only; fts is exact-keyword only and needs no embedding model.",
     "enum": [
      "hybrid",
      "vector",
      "fts"
     ],
     "title": "Mode",
     "type": "string"
    },
    "corpus_class": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "document",
         "code",
         "communication"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "enum": [
        "document",
        "code",
        "communication"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Restrict by what the resource is. 'document' is prose, 'code' is source and config, 'communication' is messages and mail. Accepts one value or a list.",
     "title": "Corpus Class"
    },
    "trust": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "authored",
         "reference",
         "received"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "enum": [
        "authored",
        "reference",
        "received"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Restrict by provenance. 'authored' is what the corpus owner wrote, 'reference' is external QA'ed material, 'received' is what others sent them. Use 'authored' for questions about the owner's own conclusions. Accepts one value or a list.",
     "title": "Trust"
    },
    "source": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Restrict to these source slugs. Accepts one value or a list.",
     "title": "Source"
    },
    "author": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Restrict to documents by this author (substring match).",
     "title": "Author"
    },
    "direction": {
     "anyOf": [
      {
       "enum": [
        "sent",
        "received"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Restrict to messages (SMS/iMessage) that went one way: 'sent' is what the corpus owner wrote, 'received' is what others wrote to them. A message thread holds both, so this is how to find the owner's own words in a conversation. Excludes everything that is not a message.",
     "title": "Direction"
    }
   },
   "required": [
    "query"
   ],
   "type": "object",
   "title": "rag_searchArguments"
  },
  "name": "rag_search",
  "outputSchema": {
   "properties": {
    "query": {
     "title": "Query",
     "type": "string"
    },
    "mode": {
     "title": "Mode",
     "type": "string"
    },
    "model": {
     "title": "Model",
     "type": "string"
    },
    "count": {
     "title": "Count",
     "type": "integer"
    },
    "hits": {
     "items": {
      "$ref": "#/$defs/Hit"
     },
     "title": "Hits",
     "type": "array"
    }
   },
   "required": [
    "query",
    "mode",
    "model",
    "count",
    "hits"
   ],
   "type": "object",
   "$defs": {
    "Hit": {
     "description": "One retrieved chunk.",
     "properties": {
      "chunk_id": {
       "title": "Chunk Id",
       "type": "integer"
      },
      "document_id": {
       "title": "Document Id",
       "type": "integer"
      },
      "location": {
       "title": "Location",
       "type": "string"
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Title"
      },
      "corpus_class": {
       "title": "Corpus Class",
       "type": "string"
      },
      "trust_tier": {
       "title": "Trust Tier",
       "type": "string"
      },
      "section": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Section"
      },
      "authors": {
       "items": {
        "type": "string"
       },
       "title": "Authors",
       "type": "array"
      },
      "matched_by": {
       "title": "Matched By",
       "type": "string"
      },
      "score": {
       "title": "Score",
       "type": "number"
      },
      "text": {
       "title": "Text",
       "type": "string"
      },
      "direction": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Direction"
      },
      "sender": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Sender"
      }
     },
     "required": [
      "chunk_id",
      "document_id",
      "location",
      "title",
      "corpus_class",
      "trust_tier",
      "section",
      "authors",
      "matched_by",
      "score",
      "text"
     ],
     "title": "Hit",
     "type": "object"
    }
   },
   "title": "SearchResult"
  }
 },
