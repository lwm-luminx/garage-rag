 {
  "description": "Answer a question from the corpus with the local model, citing excerpts as [n].\n\nRetrieval is exactly rag_search; the excerpts then go to the model named by\nfacts.model on facts.provider (the app's LlamaXPCService or a local Ollama\nserver), so Garage sends nothing off the machine; the answer comes back to\nthe calling client like any other tool result. Use rag_search instead when you want\nto read the excerpts yourself.\n",
  "inputSchema": {
   "properties": {
    "question": {
     "description": "Natural-language question to answer from the corpus.",
     "title": "Question",
     "type": "string"
    },
    "limit": {
     "default": 6,
     "description": "Excerpts to retrieve and offer the model.",
     "maximum": 20,
     "minimum": 1,
     "title": "Limit",
     "type": "integer"
    },
    "mode": {
     "default": "hybrid",
     "description": "Retrieval mode, as for rag_search.",
     "enum": [
      "hybrid",
      "vector",
      "fts"
     ],
     "title": "Mode",
     "type": "string"
    },
    "corpus_class": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "document",
         "code",
         "communication"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "enum": [
        "document",
        "code",
        "communication"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Restrict by what the resource is; see rag_search. Accepts one value or a list.",
     "title": "Corpus Class"
    },
    "trust": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "authored",
         "reference",
         "received"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "enum": [
        "authored",
        "reference",
        "received"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Restrict by provenance; see rag_search. Accepts one value or a list.",
     "title": "Trust"
    },
    "source": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Restrict to these source slugs. Accepts one value or a list.",
     "title": "Source"
    },
    "max_tokens": {
     "default": 512,
     "description": "Cap on the generated answer.",
     "maximum": 4096,
     "minimum": 16,
     "title": "Max Tokens",
     "type": "integer"
    },
    "temperature": {
     "default": 0.2,
     "description": "Sampling temperature.",
     "maximum": 2.0,
     "minimum": 0.0,
     "title": "Temperature",
     "type": "number"
    }
   },
   "required": [
    "question"
   ],
   "type": "object",
   "title": "rag_askArguments"
  },
  "name": "rag_ask",
  "outputSchema": {
   "properties": {
    "answer": {
     "title": "Answer",
     "type": "string"
    },
    "model": {
     "title": "Model",
     "type": "string"
    },
    "provider": {
     "title": "Provider",
     "type": "string"
    },
    "question": {
     "title": "Question",
     "type": "string"
    },
    "citations": {
     "items": {
      "$ref": "#/$defs/Citation"
     },
     "title": "Citations",
     "type": "array"
    },
    "prompt_tokens": {
