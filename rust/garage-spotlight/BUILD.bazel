load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# Text from files no built-in reader takes, through the system's Spotlight importers (CFPlugIn, the
# MDImporter interface), in-process on macOS. CoreFoundation, CoreServices and libobjc are bound by hand
# and linked at build time; elsewhere the crate imports nothing.
rust_library(
    name = "garage-spotlight",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_spotlight",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = ["@crates//:plist"],
)

rust_test(
    name = "garage-spotlight-test",
    crate = ":garage-spotlight",
)
