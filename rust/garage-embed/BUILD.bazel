load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The embed worker, ported from garage_rag/ops/backfill.py: chunks through the GarageService
# facade (//rust/garage-facade), model servers through its host.
rust_library(
    name = "garage-embed",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_embed",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//rust/garage-facade",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "garage-embed-test",
    crate = ":garage-embed",
)
