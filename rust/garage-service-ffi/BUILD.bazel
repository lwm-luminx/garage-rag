load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

_DEPS = [
    "//rust/garage-embed",
    "//rust/garage-service",
    "@crates//:serde_json",
    "@crates//:tokio",
]

# GarageService behind its C ABI (include/garage_service.h), linked statically into
# GarageXPCService.
rust_static_library(
    name = "garage_service_ffi_static",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_service_ffi",
    edition = "2024",
    deps = _DEPS,
)

cc_library(
    name = "garage-service-ffi",
    hdrs = ["include/garage_service.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [":garage_service_ffi_static"],
)

rust_library(
    name = "garage_service_ffi_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_service_ffi",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "garage-service-ffi-test",
    crate = ":garage_service_ffi_lib",
)
