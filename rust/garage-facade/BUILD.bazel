load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# GarageService's client (src/generated, made by //rust/protogen) and a blocking connection to it,
# shared by the embed and ingest workers.
rust_library(
    name = "garage-facade",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "garage_facade",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:hyper-util",
        "@crates//:prost",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tonic-prost",
        "@crates//:tower",
    ],
)

rust_test(
    name = "garage-facade-test",
    crate = ":garage-facade",
)
