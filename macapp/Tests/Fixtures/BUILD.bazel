load("@rules_apple//apple:resources.bzl", "apple_resource_group")

# make_corpus.py rebuilds corpus/ by hand, with python-docx; it is not a Bazel target.

# The made-up corpus the UI tests ingest (see README.md). The UI tests copy it out of their
# bundle's Resources/corpus into each test's throwaway data folder before adding it as a source.
apple_resource_group(
    name = "corpus_resources",
    structured_resources = glob(["corpus/**"]),
    visibility = ["//macapp/Tests:__subpackages__"],
)

# The same files for the tests outside the app (rust/garage-cli/tests runs the CLI over them).
filegroup(
    name = "corpus",
    srcs = glob(["corpus/**"]),
    visibility = ["//visibility:public"],
)
