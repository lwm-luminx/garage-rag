load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")

# GarageImageEmbedXPCService: CLIP-style image embedding models (SigLIP 2) on Core ML, reached
# over NSXPC by the app and, through a handed-over endpoint, by the helpers whose Python embeds
# with `image_xpc` models. No Python, no network: image bytes come in, vectors go out.
swift_library(
    name = "GarageImageEmbedXPCService_lib",
    srcs = glob(["**/*.swift"]),
    module_name = "GarageImageEmbedXPCService",
    visibility = ["//visibility:private"],
    deps = [
        "//macapp/Sources/GarageXPCKit",
        "//macapp/Sources/ImageEmbedClient",
        "//macapp/Sources/ImageEmbedEngine",
    ],
)

# The service binary. It is built on GarageXPCKit and links neither Python.framework nor
# PythonXPCService.framework.
macos_xpc_service(
    name = "GarageImageEmbedXPCService",
    bundle_id = "me.rickmark.garage-rag.image-embed-xpc",
    bundle_name = "GarageImageEmbedXPCService",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":GarageImageEmbedXPCService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    linkopts = [
        "-framework",
        "CoreML",
        "-framework",
        "ImageIO",
        "-framework",
        "CoreGraphics",
    ],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageImageEmbedXPCService_lib",
    ],
)
