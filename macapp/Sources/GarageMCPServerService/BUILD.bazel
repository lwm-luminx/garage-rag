load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")

# The Rust MCP server's C ABI as a Clang module, as //macapp/Sources/GarageEmbedWorker:GarageEmbedFFI
# does for the embed worker. The static library comes along through deps.
objc_library(
    name = "GarageMCPFFI",
    hdrs = ["GarageMCPFFI/GarageMCPFFI.h"],
    includes = ["GarageMCPFFI"],
    module_name = "GarageMCPFFI",
    visibility = ["//visibility:private"],
    deps = ["//rust/garage-mcp-ffi"],
)

# Implementation library for GarageMCPServerService: the Rust MCP server (//rust/garage-mcp-ffi,
# linked statically) and its host, which carries the local model's requests through the embed
# worker's host (llama_xpc over NSXPC, Ollama and LM Studio over URLSession).
swift_library(
    name = "GarageMCPServerService_lib",
    srcs = glob(["**/*.swift"]),
    module_name = "GarageMCPServerService",
    visibility = ["//visibility:private"],
    deps = [
        ":GarageMCPFFI",
        "//macapp/Sources/GarageEmbedWorker",
        "//macapp/Sources/GarageXPCKit",
        "//macapp/Sources/LlamaModelLoader:LlamaModelLoaderCore",
    ],
)

# The service binary. It is built on GarageXPCKit and links neither Python.framework nor
# PythonXPCService.framework.
macos_xpc_service(
    name = "GarageMCPServerService",
    bundle_id = "me.rickmark.garage-rag.mcp-server-xpc",
    bundle_name = "GarageMCPServerService",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":GarageMCPServerService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageMCPServerService_lib",
    ],
)
