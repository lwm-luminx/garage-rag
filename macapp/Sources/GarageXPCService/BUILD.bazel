load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")

# The Rust GarageService's C ABI as a Clang module, as //macapp/Sources/GarageEmbedWorker:GarageEmbedFFI
# does for the embed worker. The static library comes along through deps.
objc_library(
    name = "GarageServiceFFI",
    hdrs = ["GarageServiceFFI/GarageServiceFFI.h"],
    includes = ["GarageServiceFFI"],
    module_name = "GarageServiceFFI",
    visibility = ["//visibility:private"],
    deps = ["//rust/garage-service-ffi"],
)

# The service's delegate: GarageService (//rust/garage-service-ffi, linked statically) and its host,
# which carries the model servers' requests through the embed worker's host (llama_xpc over NSXPC,
# Ollama and LM Studio over URLSession, image models over NSXPC). The sandboxed app links it too and
# hosts one in its own process (GarageInProcessServices), since only the app can read the folders
# the user granted.
swift_library(
    name = "GarageXPCServiceCore",
    srcs = [
        "GarageRustService.swift",
        "GarageXPCServiceDelegate.swift",
    ],
    module_name = "GarageXPCServiceCore",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageServiceFFI",
        "//macapp/Sources/GarageEmbedWorker",
        "//macapp/Sources/GarageXPCKit",
        "//macapp/Sources/ImageEmbedBridge:ImageEmbedBridgeCore",
        "//macapp/Sources/LlamaModelLoader:LlamaModelLoaderCore",
    ],
)

# Implementation library for GarageXPCService
swift_library(
    name = "GarageXPCService_lib",
    srcs = ["main.swift"],
    module_name = "GarageXPCService",
    visibility = ["//visibility:private"],
    deps = [
        ":GarageXPCServiceCore",
        "//macapp/Sources/GarageXPCKit",
    ],
)

# The service binary. It is built on GarageXPCKit and links neither Python.framework nor
# PythonXPCService.framework.
macos_xpc_service(
    name = "GarageXPCService",
    bundle_id = "me.rickmark.garage-rag.xpc",
    bundle_name = "GarageXPCService",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":GarageXPCService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageXPCService_lib",
    ],
)
