load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")

# The Rust ingest loop's C ABI (rust/garage-ingest-ffi) as a Clang module, as
# //macapp/Sources/GarageEmbedWorker:GarageEmbedFFI does for the embed worker. The static library
# comes along through deps.
objc_library(
    name = "GarageIngestFFI",
    hdrs = ["GarageIngestFFI/GarageIngestFFI.h"],
    includes = ["GarageIngestFFI"],
    module_name = "GarageIngestFFI",
    visibility = ["//visibility:private"],
    deps = ["//rust/garage-ingest-ffi"],
)

# The service's delegate: the Rust ingest loop and its host. The sandboxed app links it too and hosts
# one in its own process (GarageInProcessServices), since only the app can read the folders the user
# granted.
swift_library(
    name = "GarageIngestXPCServiceCore",
    srcs = [
        "GarageIngestRunner.swift",
        "GarageIngestXPCServiceDelegate.swift",
    ],
    module_name = "GarageIngestXPCServiceCore",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageIngestFFI",
        "//macapp/Sources/GarageXPCKit",
        "//macapp/Sources/IngestClient",
    ],
)

# Implementation library for GarageIngestXPCService
swift_library(
    name = "GarageIngestXPCService_lib",
    srcs = ["main.swift"],
    module_name = "GarageIngestXPCService",
    visibility = ["//visibility:private"],
    deps = [
        ":GarageIngestXPCServiceCore",
        "//macapp/Sources/GarageXPCKit",
    ],
)

# The service binary, built on GarageXPCKit.
macos_xpc_service(
    name = "GarageIngestXPCService",
    bundle_id = "me.rickmark.garage-rag.ingest-xpc",
    bundle_name = "GarageIngestXPCService",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":GarageIngestXPCService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageIngestXPCService_lib",
    ],
)
