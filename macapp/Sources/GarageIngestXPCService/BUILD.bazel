load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")
load("//bazel:framework_linking.bzl", "framework_linked_library")

# The service's delegate. The sandboxed app links it too and hosts one in its own process
# (GarageInProcessServices), since only the app can read the folders the user granted.
swift_library(
    name = "GarageIngestXPCServiceCore",
    srcs = ["GarageIngestXPCServiceDelegate.swift"],
    module_name = "GarageIngestXPCServiceCore",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/IngestClient",
        "//macapp/Sources/PythonXPCService",
    ],
)

# Implementation library for GarageIngestXPCService
swift_library(
    name = "GarageIngestXPCService_lib",
    srcs = ["main.swift"],
    module_name = "GarageIngestXPCService",
    visibility = ["//visibility:private"],
    deps = [
        ":GarageIngestXPCServiceCore",
        "//macapp/Sources/PythonXPCService",
    ],
)

# The actual XPC service binary
macos_xpc_service(
    name = "GarageIngestXPCService",
    additional_linker_inputs = [
        "//ext/python:python_framework",
        "//ext/pythonkit:PythonKit",
        "//macapp/Sources/PythonXPCService:PythonXPCService_signed",
    ],
    bundle_id = "me.rickmark.garage-rag.ingest-xpc",
    bundle_name = "GarageIngestXPCService",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":GarageIngestXPCService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    linkopts = [
        "-F$(location //ext/python:python_framework)/..",
        "-framework",
        "Python",
        "-F$(location //macapp/Sources/PythonXPCService:PythonXPCService_signed)/..",
        "-framework",
        "PythonXPCService",
    ],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageIngestXPCService_linked",
    ],
)

# The service's library without the static copy of PythonXPCService.framework's code, which it links
# (see //bazel:framework_linking.bzl).
framework_linked_library(
    name = "GarageIngestXPCService_linked",
    framework_deps = ["//macapp/Sources/PythonXPCService"],
    deps = [":GarageIngestXPCService_lib"],
)
