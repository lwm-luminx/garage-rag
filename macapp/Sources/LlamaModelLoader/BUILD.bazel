load("@rules_swift//swift:swift.bzl", "swift_library")

# LlamaModelLoader: loads llama_xpc models on demand over NSXPC (LlamaXPCService `ensureModel`)
# and sends llama-server requests over NSXPC (`LlamaServerRequests`). Resolves a model's slug to
# its downloaded GGUF and load settings (shared with the Models page) and deduplicates concurrent
# loads. The Rust embed worker and GarageService reach LlamaXPCService through it.
swift_library(
    name = "LlamaModelLoader",
    srcs = glob(["*.swift"]),
    module_name = "LlamaModelLoader",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/GarageXPCKit",
        "//macapp/Sources/LlamaClient",
    ],
)
