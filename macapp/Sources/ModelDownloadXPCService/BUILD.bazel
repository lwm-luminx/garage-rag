load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")

# Implementation library for ModelDownloadXPCService. It runs no Python, so it is built on
# GarageXPCKit alone and links neither Python.framework nor PythonXPCService.framework.
swift_library(
    name = "ModelDownloadXPCService_lib",
    srcs = glob(["**/*.swift"]),
    module_name = "ModelDownloadXPCService",
    visibility = ["//visibility:private"],
    deps = [
        "//macapp/Sources/GarageXPCKit",
        "//macapp/Sources/ModelDownloadClient",
    ],
)

# The actual XPC service binary
macos_xpc_service(
    name = "ModelDownloadXPCService",
    bundle_id = "me.rickmark.garage-rag.model-download-xpc",
    bundle_name = "ModelDownloadXPCService",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":ModelDownloadXPCService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":ModelDownloadXPCService_lib",
    ],
)
