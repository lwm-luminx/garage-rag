load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")

# The service's delegate: the Rust embed worker (//rust/garage-embed-ffi, linked statically) and
# its host. The sandboxed app links it too and hosts one in its own process
# (GarageInProcessServices), since image models read files only the app can read.
swift_library(
    name = "GarageEmbedXPCServiceCore",
    srcs = ["GarageEmbedXPCServiceDelegate.swift"],
    module_name = "GarageEmbedXPCServiceCore",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/EmbedClient",
        "//macapp/Sources/GarageEmbedWorker",
        "//macapp/Sources/GarageXPCKit",
        "//macapp/Sources/ImageEmbedBridge:ImageEmbedBridgeCore",
        "//macapp/Sources/LlamaModelLoader:LlamaModelLoaderCore",
    ],
)

# Implementation library for GarageEmbedXPCService
swift_library(
    name = "GarageEmbedXPCService_lib",
    srcs = ["main.swift"],
    module_name = "GarageEmbedXPCService",
    visibility = ["//visibility:private"],
    deps = [
        ":GarageEmbedXPCServiceCore",
        "//macapp/Sources/GarageXPCKit",
    ],
)

# The service binary. It is built on GarageXPCKit and links neither Python.framework nor
# PythonXPCService.framework.
macos_xpc_service(
    name = "GarageEmbedXPCService",
    bundle_id = "me.rickmark.garage-rag.embed-xpc",
    bundle_name = "GarageEmbedXPCService",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":GarageEmbedXPCService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageEmbedXPCService_lib",
    ],
)
