load("//bazel:launcher_app.bzl", "garage_launcher_app")

# `garage-mcp`, as the helper bundle Garage.app/Contents/Helpers/garage-mcp.app. The file
# `garage-mcp` next to this BUILD file is the forwarder that becomes Garage.app/Contents/MacOS/garage-mcp.
exports_files(
    ["garage-mcp"],
    visibility = [
        "//garage_python/tests:__pkg__",
        "//macapp:__subpackages__",
    ],
)

garage_launcher_app(
    name = "garage_mcp_app",
    bundle_id = "me.rickmark.garage-rag.mcp-server-cli",
    bundle_name = "garage-mcp",
    developer_id_entitlements = ":GarageMCPCLI.developer_id.entitlements",
    main = "main.swift",
    provisioning_profile = "//bazel:garage_mcp_provisioning_profile",
    store_entitlements = ":GarageMCPCLI.entitlements",
    visibility = ["//visibility:public"],
)
