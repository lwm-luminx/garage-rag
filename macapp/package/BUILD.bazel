load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//bazel:lipo.bzl", "macos_lipo_app")
load("//bazel:notarytool.bzl", "notarytool")
load("//bazel:pkgbuild.bzl", "pkg_install", "pkgbuild")

# gazelle:exclude notarize_release.sh
# gazelle:exclude publish_appcast.sh

exports_files(
    ["notarize_release.sh"],
    visibility = ["//garage_python/tests:__pkg__"],
)

# Every target here signs with a Developer ID identity or talks to the notary
# service, so all are `manual`: `bazel build //...` (CI included) skips them and
# they build only when named, on a machine that holds those identities.

# 1. Stage the app for distribution: prune, thin to arm64, codesign for Developer ID
macos_lipo_app(
    name = "GarageApp",
    app = "//macapp/Sources/GarageApp:GarageApp",
    arch = "arm64",
    signing_identity = "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# 2. Notarize the app on its own. A release uses notarize_all (3), which also staples.
notarytool(
    name = "GarageAppNotary",
    app = ":GarageApp",
    keychain_profile = "Primary",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "GarageNotary",
    actual = ":GarageAppNotary",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# 3. Notarize the app, staple it, build the installer from the stapled app, then notarize
#    and staple the installer: `aspect run //macapp/package:notarize_all`. Writes
#    dist/Garage-<version>.zip and dist/GarageInstaller_arm64.pkg, the release's two files.
#    These steps run in one script, not as build actions, because stapling needs the ticket
#    the notary service issues, so everything after it has to wait for notarization.
sh_binary(
    name = "notarize_all",
    srcs = ["notarize_release.sh"],
    args = [
        "--archive",
        "$(rootpath :GarageApp)",
        "--keychain-profile",
        "Primary",
        "--installer-identity",
        "'Developer ID Installer: Richard Penwell (DWVXMLB45Y)'",
        "--identifier",
        "me.rickmark.garage-rag.pkg",
    ],
    data = [":GarageApp"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

# 4. A signed installer for local installs (`aspect run //macapp/package:install`). Its app is
#    not notarized, so it is never a release file; notarize_all builds that one.
pkgbuild(
    name = "GarageInstaller",
    app = ":GarageApp",
    identifier = "me.rickmark.garage-rag.pkg",
    install_location = "/Applications",
    signing_identity = "Developer ID Installer: Richard Penwell (DWVXMLB45Y)",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# 5. Packaging target grouping all Developer ID artifacts
filegroup(
    name = "package",
    srcs = [
        ":GarageApp",
        ":GarageInstaller",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# 6. Add the notarized archive to the Sparkle feed (docs/appcast.xml), signed with the
#    EdDSA key in the login Keychain: `aspect run //macapp/package:publish_appcast -- <tag>`.
#    See macapp/README.md, "Cutting a release".
sh_binary(
    name = "publish_appcast",
    srcs = ["publish_appcast.sh"],
    args = [
        "--archive",
        "$(rootpath :GarageApp)",
        "--generate-appcast",
        "$(rootpath //ext/sparkle:generate_appcast)",
        "--sign-update",
        "$(rootpath //ext/sparkle:sign_update)",
        "--generate-keys",
        "$(rootpath //ext/sparkle:generate_keys)",
        "--sparkle-plist",
        "$(rootpath //macapp/Sources/GarageApp:Sparkle.plist)",
    ],
    data = [
        ":GarageApp",
        "//ext/sparkle:generate_appcast",
        "//ext/sparkle:generate_keys",
        "//ext/sparkle:sign_update",
        "//macapp/Sources/GarageApp:Sparkle.plist",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

pkg_install(
    name = "install",
    pkg = ":GarageInstaller",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
