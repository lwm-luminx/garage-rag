"""The Developer ID build of Garage for GitHub releases: stage, notarize, staple, package.

`--config=developer_id` and these targets sign with the keychain's Developer ID certificates and
the installed Developer ID profiles (//bazel:signing_identity.bzl), so the release can be made from
a checkout of this repository on any Mac that holds them. RELEASING.md ("GitHub release") is the
order. The Sparkle feed and the App Store build are garage-enterprise's.
"""

load("@garage_signing_identity//:identity.bzl", "DEVELOPER_ID_IDENTITY", "DEVELOPER_ID_INSTALLER_IDENTITY")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//bazel:lipo.bzl", "macos_lipo_app")
load("//bazel:notarytool.bzl", "notarytool")
load("//bazel:pkgbuild.bzl", "pkg_install", "pkgbuild")

# gazelle:exclude notarize_release.sh

# The notarytool keychain profile (`xcrun notarytool store-credentials <name>`) the targets below
# submit with. Another name: `aspect run //macapp/package:notarize_all -- --keychain-profile <name>`.
NOTARY_PROFILE = "Primary"

# Every target here signs with a Developer ID identity or talks to the notary service, so all are
# `manual`: `bazel build //...` (CI included) skips them and they build only when named, on a Mac
# that holds those identities.

# 1. Stage the app for distribution: prune, thin to arm64, codesign for Developer ID.
macos_lipo_app(
    name = "GarageApp",
    app = "//macapp/Sources/GarageApp:GarageApp",
    arch = "arm64",
    platform = "//bazel:developer_id",
    signing_identity = DEVELOPER_ID_IDENTITY,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# 2. Notarize the app on its own. A release uses notarize_all (3), which also staples.
notarytool(
    name = "GarageAppNotary",
    app = ":GarageApp",
    keychain_profile = NOTARY_PROFILE,
    tags = ["manual"],
)

# 3. Notarize the app, staple it, build the installer from the stapled app, then notarize and
#    staple the installer: `aspect run //macapp/package:notarize_all`. Writes
#    dist/Garage-<version>.zip and dist/GarageInstaller_arm64.pkg, the GitHub release's two files.
#    These run in one script, not as build actions, because stapling needs the ticket the notary
#    service issues, so everything after it waits for notarization.
sh_binary(
    name = "notarize_all",
    srcs = ["notarize_release.sh"],
    args = [
        "--archive",
        "$(rootpath :GarageApp)",
        "--keychain-profile",
        NOTARY_PROFILE,
        "--installer-identity",
        "'" + DEVELOPER_ID_INSTALLER_IDENTITY + "'",
        "--identifier",
        "me.rickmark.garage-rag.pkg",
    ],
    data = [":GarageApp"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

# 4. A signed installer for local installs (`aspect run //macapp/package:install`). Its app is not
#    notarized, so it is never a release file; notarize_all builds that one.
pkgbuild(
    name = "GarageInstaller",
    app = ":GarageApp",
    identifier = "me.rickmark.garage-rag.pkg",
    install_location = "/Applications",
    signing_identity = DEVELOPER_ID_INSTALLER_IDENTITY,
    tags = ["manual"],
)

pkg_install(
    name = "install",
    pkg = ":GarageInstaller",
    tags = ["manual"],
)
